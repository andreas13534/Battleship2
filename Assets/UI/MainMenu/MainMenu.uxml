                    <ui:Label name="TurnLabel" text="DU BIST AM ZUG" class="turn-label" />
                </ui:VisualElement>
                <ui:Button name="SurrenderButton" text="AUFGEBEN" class="topbar-button hidden" />
            </ui:VisualElement>

            <ui:VisualElement class="battle-main">
