        <ui:VisualElement name="SetupScreen" class="screen setup-screen hidden">
            <ui:VisualElement class="compact-header">
                <ui:Button name="SetupBackButton" text="‹" class="icon-button" />
                <ui:VisualElement class="header-copy hidden">
                    <ui:Label text="FLOTTE AUFSTELLEN" class="screen-title" />
