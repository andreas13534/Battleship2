                    <ui:VisualElement name="BattleCommanderPortrait" class="battle-commander-portrait portrait-standard hidden">
                        <ui:Label name="BattleCommanderMonogram" text="FC" class="battle-portrait-monogram" />
                    </ui:VisualElement>
                    <ui:VisualElement class="battle-commander-copy">
                        <ui:Label name="BattleCommanderName" text="STANDARD-KOMMANDANT" class="battle-commander-name hidden" />
