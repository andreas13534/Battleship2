                    <ui:VisualElement class="corner corner-tr" />
                    <ui:VisualElement class="corner corner-bl" />
                    <ui:VisualElement class="corner corner-br" />
                </ui:VisualElement>
                <ui:Label name="BattleMessage" text="ZIEL WÄHLEN" class="battle-message" />
            </ui:VisualElement>

            <ui:VisualElement class="command-console">
