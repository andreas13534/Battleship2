    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(75, 223, 255, 0.54);
    border-right-color: rgba(75, 223, 255, 0.54);
    border-top-color: rgba(75, 223, 255, 0.54);
    border-bottom-color: rgba(75, 223, 255, 0.54);
}

.oracle-distant-ship {
    position: absolute;
    left: 36%;
    width: 28%;
    height: 11%;
    top: 42%;
    opacity: 0.82;
    background-image: url("project://database/Assets/Art/NavalCommand/shot-animation/shot-enemy-frigate.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(188, 215, 221);
}
.oracle-sky-beam {
    position: absolute;
    left: 42%;
