    border-right-color: rgba(86, 211, 255, 0.72);
    border-top-color: rgba(86, 211, 255, 0.72);
    border-bottom-color: rgba(86, 211, 255, 0.72);
}

/* Dae-Hyun Kwon // VIPER ability cinematics */
.viper-toxic-grade,
.viper-mine-grade {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}
.viper-toxic-grade {
    background-color: rgba(18, 55, 4, 0.18);
}
.viper-mine-grade {
    background-color: rgba(0, 15, 18, 0.32);
}
.viper-chemical-target-ship {
    position: absolute;
    left: 32%;
    top: 41%;
    width: 36%;
    height: 14%;
    opacity: 0;
    background-image: url("project://database/Assets/Art/NavalCommand/shot-animation/shot-enemy-frigate.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(116, 138, 126);
    transition-property: opacity, -unity-background-image-tint-color;
    transition-duration: 0.2s;
}
.viper-chemical-hit .viper-chemical-target-ship {
    opacity: 0.88;
}
.viper-chemical-bomb {
    position: absolute;
    left: 42%;
    top: -25%;
    width: 16%;
    height: 25%;
    opacity: 1;
    rotate: 7deg;
    background-image: url("project://database/Assets/Art/NavalCommand/shot-animation/viper-chemical-bomb.png");
    -unity-background-scale-mode: scale-to-fit;
    transition-property: top, rotate, opacity, scale;
    transition-duration: 0.76s;
    transition-timing-function: ease-in;
}
.viper-bomb-dropping .viper-chemical-bomb {
    top: 46%;
    rotate: -4deg;
    scale: 0.72 0.72;
}
.viper-chemical-hit.viper-bomb-dropping .viper-chemical-bomb {
    top: 32%;
}
.viper-chemical-impact-active .viper-chemical-bomb {
    opacity: 0;
    scale: 0.45 0.45;
}
.viper-chemical-impact {
    position: absolute;
    left: 38%;
    top: 51%;
    width: 24%;
    height: 10%;
    opacity: 0;
    scale: 0.25 0.25;
    background-color: rgba(157, 255, 62, 0.55);
    border-left-width: 5px;
    border-right-width: 5px;
    border-top-width: 5px;
    border-bottom-width: 5px;
    border-left-color: rgba(207, 255, 114, 0.8);
    border-right-color: rgba(207, 255, 114, 0.8);
    border-top-color: rgba(207, 255, 114, 0.8);
    border-bottom-color: rgba(207, 255, 114, 0.8);
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
    transition-property: opacity, scale;
    transition-duration: 0.32s;
}
.viper-chemical-hit .viper-chemical-impact { top: 44%; }
.viper-chemical-impact-active .viper-chemical-impact {
    opacity: 0.86;
    scale: 1.35 1.35;
}
.viper-particle-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    opacity: 0;
    -unity-background-scale-mode: scale-and-crop;
    transition-property: opacity;
    transition-duration: 0.16s;
}
.viper-bomb-dropping .viper-particle-layer { opacity: 0.58; }
.viper-chemical-impact-active .viper-particle-layer { opacity: 1; }
.viper-gas-bloom {
    position: absolute;
    left: 22%;
    top: 37%;
    width: 56%;
    height: 33%;
    opacity: 0;
    scale: 0.35 0.35;
    background-color: rgba(88, 255, 44, 0.18);
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
    transition-property: opacity, scale;
    transition-duration: 1.25s;
}
.viper-chemical-impact-active .viper-gas-bloom {
    opacity: 0.54;
    scale: 1.25 1.25;
}
.ability-cinematic-viper-chemical .ability-cinematic-result {
    color: rgb(174, 255, 80);
    border-left-color: rgba(143, 255, 63, 0.75);
    border-right-color: rgba(143, 255, 63, 0.75);
    border-top-color: rgba(143, 255, 63, 0.75);
    border-bottom-color: rgba(143, 255, 63, 0.75);
}

.viper-mine-silhouette {
    position: absolute;
    left: 35%;
    top: 49%;
    width: 30%;
    height: 22%;
    opacity: 0;
    scale: 0.68 0.68;
    translate: 0 34px;
    transition-property: opacity, scale, translate;
    transition-duration: 0.38s;
    transition-timing-function: ease-out;
}
.viper-mine-core {
    position: absolute;
    left: 25%;
    right: 25%;
    top: 21%;
    bottom: 21%;
    background-color: rgba(0, 8, 9, 0.92);
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-color: rgba(22, 47, 45, 0.9);
    border-right-color: rgba(22, 47, 45, 0.9);
    border-top-color: rgba(22, 47, 45, 0.9);
    border-bottom-color: rgba(22, 47, 45, 0.9);
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
}
.viper-mine-spike {
    position: absolute;
    left: 47%;
    top: 3%;
    width: 6%;
    height: 40%;
    transform-origin: 50% 117%;
    background-color: rgba(0, 8, 9, 0.94);
}
.viper-mine-spike-1 { rotate: 0deg; }
.viper-mine-spike-2 { rotate: 45deg; }
.viper-mine-spike-3 { rotate: 90deg; }
.viper-mine-spike-4 { rotate: 135deg; }
.viper-mine-spike-5 { rotate: 180deg; }
.viper-mine-spike-6 { rotate: 225deg; }
.viper-mine-spike-7 { rotate: 270deg; }
.viper-mine-spike-8 { rotate: 315deg; }
.viper-mine-visible .viper-mine-silhouette {
    opacity: 0.78;
    scale: 1 1;
    translate: 0 0;
}
.viper-mine-submerged .viper-mine-silhouette {
    opacity: 0;
    scale: 0.82 0.82;
    translate: 0 48px;
}
.ability-cinematic-viper-mine .ability-cinematic-result {
    color: rgb(135, 235, 208);
    border-left-color: rgba(94, 222, 193, 0.66);
    border-right-color: rgba(94, 222, 193, 0.66);
    border-top-color: rgba(94, 222, 193, 0.66);
    border-bottom-color: rgba(94, 222, 193, 0.66);
}

/* Imani Cross // RAPTOR cockpit fly-by */
.ability-cinematic-raptor-jet-start {
