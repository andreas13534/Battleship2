}
.online-input .unity-base-text-field__input,
.online-input .unity-text-field__input,
.online-input .unity-text-input {
    color: rgb(3, 35, 24);
    background-color: rgb(240, 250, 244);
    -unity-cursor-color: rgb(3, 52, 35);
}
.online-input:focus,
.online-input .unity-base-text-field__input:focus,
.online-input .unity-text-field__input:focus {
    color: rgb(0, 24, 16);
}
.profile-input { width: 100%; }

.account-danger-zone {
    margin-top: 28px;
    padding-top: 22px;
    border-top-width: 1px;
    border-top-color: rgba(255, 74, 74, 0.35);
}

.danger-button {
    margin-top: 10px;
    color: rgb(255, 115, 115);
    border-color: rgba(255, 74, 74, 0.72);
    background-color: rgba(48, 8, 12, 0.78);
}
.friend-add-button { width: 160px; height: 58px; margin-left: 12px; }
.friends-list { margin-top: 18px; }
.friend-row {
    min-height: 74px;
    margin-top: 8px;
    padding-left: 16px;
    padding-right: 10px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 14, 11, 0.82);
    border-left-width: 3px;
    border-left-color: rgba(75, 255, 157, 0.42);
}
.friend-row-offline { opacity: 0.58; }
.friend-row-request { border-left-color: rgb(255, 197, 69); }
.friend-name { flex-grow: 1; font-size: 18px; color: rgb(184, 239, 210); }
.friend-state { width: 120px; font-size: 12px; color: rgba(117, 255, 177, 0.62); }
.friend-action { min-width: 116px; height: 48px; margin-left: 8px; }
.hub-message { max-width: 760px; align-self: center; }
.matchmaking-radar {
    width: 360px;
    height: 360px;
    margin-bottom: 48px;
    overflow: hidden;
    background-color: rgba(3, 42, 28, 0.72);
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-color: rgba(79, 255, 166, 0.66);
    border-right-color: rgba(79, 255, 166, 0.66);
    border-top-color: rgba(79, 255, 166, 0.66);
    border-bottom-color: rgba(79, 255, 166, 0.66);
    border-top-left-radius: 180px;
    border-top-right-radius: 180px;
    border-bottom-left-radius: 180px;
    border-bottom-right-radius: 180px;
}
.matchmaking-radar-inner {
    position: absolute;
    left: 24%;
    right: 24%;
    top: 24%;
    bottom: 24%;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(75, 255, 157, 0.3);
    border-right-color: rgba(75, 255, 157, 0.3);
    border-top-color: rgba(75, 255, 157, 0.3);
    border-bottom-color: rgba(75, 255, 157, 0.3);
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
}
.matchmaking-sweep {
    position: absolute;
    left: 49%;
    top: 8%;
    width: 2%;
    height: 43%;
    transform-origin: 50% 100%;
    rotate: 28deg;
    background-color: rgb(105, 255, 177);
}
.matchmaking-title { -unity-text-align: middle-center; }
.matchmaking-cancel { width: 420px; margin-top: 32px; }

.ranked-match-found-screen {
    align-items: center;
    justify-content: center;
    overflow: hidden;
    opacity: 0;
    background-color: rgb(1, 13, 15);
    transition-property: opacity;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
}

.ranked-match-found-grid {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    opacity: 0.24;
}

.ranked-match-found-grid-line { position: absolute; background-color: rgba(62, 255, 173, 0.32); }
.ranked-match-found-grid-v { top: 0; bottom: 0; width: 1px; }
.ranked-match-found-grid-h { left: 0; right: 0; height: 1px; }
.ranked-match-found-grid .grid-v-one { left: 27%; }
.ranked-match-found-grid .grid-v-two { right: 27%; }
.ranked-match-found-grid .grid-h-one { top: 29%; }
.ranked-match-found-grid .grid-h-two { bottom: 24%; }

.ranked-match-found-kicker {
    margin-bottom: 30px;
    font-size: 13px;
    letter-spacing: 5px;
    color: rgba(126, 255, 191, 0.7);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.ranked-match-found-arena {
    width: 92%;
    max-width: 920px;
    min-height: 390px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.ranked-match-player-card {
    width: 40%;
    min-width: 0;
    min-height: 350px;
    padding: 22px 16px;
    align-items: center;
    justify-content: center;
    opacity: 0;
    background-color: rgba(5, 39, 32, 0.94);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-top-left-radius: 22px;
    border-top-right-radius: 22px;
    border-bottom-left-radius: 22px;
    border-bottom-right-radius: 22px;
    transition-property: opacity, translate, scale;
    transition-duration: 0.42s;
    transition-timing-function: ease-out;
}

.ranked-match-player-own {
    translate: -150px 0;
    scale: 0.92 0.92;
    border-left-color: rgb(76, 255, 164);
    border-right-color: rgba(76, 255, 164, 0.38);
    border-top-color: rgba(76, 255, 164, 0.38);
    border-bottom-color: rgba(76, 255, 164, 0.38);
}

.ranked-match-player-opponent {
    translate: 150px 0;
    scale: 0.92 0.92;
    border-left-color: rgba(255, 111, 88, 0.42);
    border-right-color: rgb(255, 111, 88);
    border-top-color: rgba(255, 111, 88, 0.42);
    border-bottom-color: rgba(255, 111, 88, 0.42);
}

.ranked-match-found-cards-in .ranked-match-player-card {
    opacity: 1;
    translate: 0 0;
    scale: 1 1;
}

.ranked-match-player-side {
    margin-bottom: 14px;
    font-size: 10px;
    letter-spacing: 3px;
    color: rgba(167, 239, 202, 0.58);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.ranked-match-avatar {
    width: 184px;
    height: 184px;
    align-items: center;
    justify-content: center;
    background-color: rgb(3, 23, 23);
    -unity-background-scale-mode: scale-and-crop;
    border-left-width: 4px;
    border-right-width: 4px;
    border-top-width: 4px;
    border-bottom-width: 4px;
    border-top-left-radius: 92px;
    border-top-right-radius: 92px;
    border-bottom-left-radius: 92px;
    border-bottom-right-radius: 92px;
}

.ranked-match-own-avatar {
    border-left-color: rgb(80, 255, 169);
    border-right-color: rgb(80, 255, 169);
    border-top-color: rgb(80, 255, 169);
    border-bottom-color: rgb(80, 255, 169);
}

.ranked-match-opponent-avatar {
    border-left-color: rgb(255, 112, 89);
    border-right-color: rgb(255, 112, 89);
    border-top-color: rgb(255, 112, 89);
    border-bottom-color: rgb(255, 112, 89);
}

.ranked-match-avatar-initials {
    font-size: 42px;
    letter-spacing: 3px;
    color: rgb(220, 255, 237);
    -unity-font-style: bold;
}

.ranked-match-player-name {
    width: 100%;
    margin-top: 18px;
    font-size: 21px;
    letter-spacing: 2px;
    white-space: normal;
    color: rgb(229, 255, 240);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.ranked-match-versus {
    width: 16%;
    min-width: 82px;
    align-items: center;
    justify-content: center;
}

.ranked-match-versus-ring {
    width: 78px;
    height: 78px;
    align-items: center;
    justify-content: center;
    opacity: 0;
    scale: 2.2 2.2;
    rotate: -14deg;
    background-color: rgb(244, 193, 48);
    border-top-left-radius: 39px;
    border-top-right-radius: 39px;
    border-bottom-left-radius: 39px;
    border-bottom-right-radius: 39px;
    transition-property: opacity, scale, rotate;
    transition-duration: 0.28s;
    transition-timing-function: ease-out;
}

.ranked-match-found-vs-impact .ranked-match-versus-ring {
    opacity: 1;
    scale: 1 1;
    rotate: 0deg;
}

.ranked-match-versus-label {
    font-size: 27px;
    color: rgb(24, 20, 3);
    -unity-font-style: bold;
}

.ranked-match-found-status {
    margin-top: 34px;
    font-size: 15px;
    letter-spacing: 5px;
    color: rgb(247, 208, 80);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.ranked-match-found-visible { opacity: 1; }
.ranked-match-found-out { opacity: 0; transition-duration: 0.28s; }

/* Elias Voss ability cinematics */
.commander-ability-cinematic {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    opacity: 0;
    background-color: rgba(0, 8, 10, 0.97);
    align-items: center;
    justify-content: center;
    transition-property: opacity;
    transition-duration: 0.16s;
}
.ability-cinematic-show { opacity: 1; }
.ability-cinematic-finish { opacity: 0; transition-duration: 0.22s; }
.ability-cinematic-panel {
    width: 88%;
    height: 76%;
    padding: 48px;
    background-color: rgba(2, 19, 17, 0.96);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(67, 255, 168, 0.46);
    border-right-color: rgba(67, 255, 168, 0.46);
    border-top-color: rgba(67, 255, 168, 0.46);
    border-bottom-color: rgba(67, 255, 168, 0.46);
}
.ability-cinematic-kicker {
    height: 48px;
    font-size: 15px;
    letter-spacing: 4px;
    color: rgba(112, 255, 190, 0.58);
}
.ability-cinematic-title {
    height: 82px;
    font-size: 42px;
    letter-spacing: 7px;
    -unity-font-style: bold;
    color: rgb(103, 255, 178);
}
.ability-cinematic-result {
    height: 86px;
    opacity: 0;
    translate: 0 24px;
    align-self: stretch;
    -unity-text-align: middle-center;
    font-size: 23px;
    letter-spacing: 4px;
    -unity-font-style: bold;
    color: rgb(102, 255, 177);
    transition-property: opacity, translate, color;
    transition-duration: 0.2s;
}
.ability-cinematic-result-visible .ability-cinematic-result {
    opacity: 1;
    translate: 0 0;
}

.oracle-scan-stage {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}
.oracle-scan-grid {
    position: relative;
    width: 610px;
    height: 610px;
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    overflow: hidden;
    background-color: rgba(1, 12, 14, 0.96);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(63, 255, 179, 0.66);
    border-right-color: rgba(63, 255, 179, 0.66);
    border-top-color: rgba(63, 255, 179, 0.66);
    border-bottom-color: rgba(63, 255, 179, 0.66);
}
.oracle-scan-cell {
    width: 33.333%;
    height: 33.333%;
    opacity: 0.42;
    background-color: rgba(5, 31, 28, 0.78);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(77, 255, 185, 0.32);
    border-right-color: rgba(77, 255, 185, 0.32);
    border-top-color: rgba(77, 255, 185, 0.32);
    border-bottom-color: rgba(77, 255, 185, 0.32);
    transition-property: opacity, background-color;
    transition-duration: 0.12s;
}
.oracle-cell-lit {
    opacity: 1;
    background-color: rgba(47, 255, 163, 0.18);
}
.oracle-sweep {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 110px;
    opacity: 0;
    translate: 0 -120px;
    background-color: rgba(66, 255, 176, 0.22);
    border-bottom-width: 5px;
    border-bottom-color: rgba(133, 255, 211, 0.9);
    transition-property: opacity, translate;
    transition-duration: 0.95s;
    transition-timing-function: ease-in-out;
}
.oracle-scan-active .oracle-sweep {
    opacity: 1;
    translate: 0 620px;
}
.oracle-contact .oracle-scan-cell {
    background-color: rgba(255, 93, 69, 0.16);
    border-left-color: rgba(255, 119, 92, 0.54);
    border-right-color: rgba(255, 119, 92, 0.54);
    border-top-color: rgba(255, 119, 92, 0.54);
    border-bottom-color: rgba(255, 119, 92, 0.54);
}
.oracle-contact .ability-cinematic-result { color: rgb(255, 114, 85); }

.ares-repair-stage {
    position: relative;
    flex-grow: 1;
    overflow: hidden;
    background-color: rgba(1, 13, 15, 0.94);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 203, 82, 0.36);
    border-right-color: rgba(255, 203, 82, 0.36);
    border-top-color: rgba(255, 203, 82, 0.36);
    border-bottom-color: rgba(255, 203, 82, 0.36);
}
.ares-repair-ship {
    position: absolute;
    left: 8%;
    right: 8%;
    top: 31%;
    height: 250px;
    opacity: 0.58;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(255, 120, 92);
    transition-property: opacity, scale, -unity-background-image-tint-color;
    transition-duration: 0.78s;
}
.ares-repair-active .ares-repair-ship {
    opacity: 1;
    scale: 1.035 1.035;
    -unity-background-image-tint-color: rgb(255, 220, 123);
}
.ares-repair-complete .ares-repair-ship {
    scale: 1 1;
    -unity-background-image-tint-color: rgb(111, 255, 178);
}
.ares-repair-beam {
    position: absolute;
    top: -290px;
    width: 10px;
    height: 360px;
    opacity: 0;
    translate: 0 0;
    background-color: rgba(255, 220, 114, 0.82);
    border-left-width: 2px;
    border-right-width: 2px;
    border-left-color: rgba(91, 255, 184, 0.65);
    border-right-color: rgba(91, 255, 184, 0.65);
    transition-property: opacity, translate;
    transition-duration: 0.68s;
    transition-timing-function: ease-out;
}
.ares-repair-beam-1 { left: 28%; }
.ares-repair-beam-2 { left: 50%; }
.ares-repair-beam-3 { left: 72%; }
.ares-repair-active .ares-repair-beam {
    opacity: 0.92;
    translate: 0 600px;
}
.ares-repair-plate {
    position: absolute;
    width: 74px;
    height: 30px;
    opacity: 0;
    scale: 1.8 1.8;
    background-color: rgba(255, 222, 123, 0.82);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(99, 255, 179);
    border-right-color: rgb(99, 255, 179);
    border-top-color: rgb(99, 255, 179);
    border-bottom-color: rgb(99, 255, 179);
    transition-property: opacity, scale, translate;
    transition-duration: 0.55s;
}
.ares-repair-plate-1 { left: 27%; top: 43%; translate: -90px -80px; }
.ares-repair-plate-2 { left: 41%; top: 47%; translate: -30px 90px; }
.ares-repair-plate-3 { left: 56%; top: 42%; translate: 50px -85px; }
.ares-repair-plate-4 { left: 68%; top: 48%; translate: 90px 75px; }
.ares-repair-active .ares-repair-plate {
    opacity: 1;
    scale: 1 1;
    translate: 0 0;
}
.ares-repair-complete .ares-repair-plate {
    opacity: 0.15;
    scale: 0.7 0.7;
}
.ares-progress {
    position: absolute;
    left: 15%;
    right: 15%;
    bottom: 11%;
    height: 30px;
    padding: 4px;
    background-color: rgba(0, 8, 9, 0.92);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 219, 111, 0.62);
    border-right-color: rgba(255, 219, 111, 0.62);
    border-top-color: rgba(255, 219, 111, 0.62);
    border-bottom-color: rgba(255, 219, 111, 0.62);
}
.ares-progress-fill {
    width: 0;
    height: 100%;
    background-color: rgb(255, 211, 91);
    transition-property: width, background-color;
    transition-duration: 0.9s;
}
.ares-repair-active .ares-progress-fill { width: 100%; }
.ares-repair-complete .ares-progress-fill { background-color: rgb(91, 255, 168); }
.ability-cinematic-ares .ability-cinematic-kicker { color: rgba(255, 221, 126, 0.68); }
.ability-cinematic-ares .ability-cinematic-title { color: rgb(255, 218, 111); }
.ability-cinematic-ares .ability-cinematic-result { color: rgb(101, 255, 174); }

/* Water-scene presentation shared by normal shots and Elias Voss */
.ability-ocean-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("project://database/Assets/Art/NavalCommand/shot-animation/shot-ocean-bg.png");
    -unity-background-scale-mode: scale-and-crop;
}
.ability-ocean-grade {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 18, 24, 0.2);
}
.commander-ability-cinematic .ability-cinematic-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    width: auto;
    height: auto;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
