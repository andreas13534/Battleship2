.leaderboard-list-modern .friend-row { min-height: 72px; border-left-color: rgb(225, 199, 71); }
.profile-identity-card { min-height: 235px; margin-bottom: 18px; align-items: center; justify-content: center; background-color: rgba(5, 31, 22, 0.88); border-top-left-radius: 24px; border-top-right-radius: 24px; border-bottom-left-radius: 24px; border-bottom-right-radius: 24px; }
.profile-large-avatar { width: 110px; height: 110px; margin-bottom: 16px; align-items: center; justify-content: center; background-color: rgb(11, 65, 42); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgb(87, 255, 162); border-right-color: rgb(87, 255, 162); border-top-color: rgb(87, 255, 162); border-bottom-color: rgb(87, 255, 162); border-top-left-radius: 55px; border-top-right-radius: 55px; border-bottom-left-radius: 55px; border-bottom-right-radius: 55px; }
.profile-large-avatar-text { font-size: 30px; color: rgb(145, 255, 196); -unity-font-style: bold; }
.profile-tagline { font-size: 13px; letter-spacing: 2px; color: rgb(197, 243, 217); }
.profile-form-card { padding: 22px; background-color: rgba(4, 25, 19, 0.9); border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-left-radius: 20px; border-bottom-right-radius: 20px; }
.field-label { font-size: 11px; letter-spacing: 3px; color: rgba(136, 236, 181, 0.66); -unity-font-style: bold; }
.profile-signout-button { margin-top: 20px; }

/* Profil // minimalistische Kontoübersicht */
.profile-minimal-scroll {
    padding-left: 30px;
    padding-right: 30px;
    padding-top: 24px;
    padding-bottom: 38px;
}
.profile-minimal-scroll .unity-scroll-view__horizontal-scroller { display: none; }
.profile-minimal-scroll .unity-scroll-view__content-container { min-height: 100%; }
.profile-minimal-hero {
    align-items: center;
    padding-top: 12px;
    padding-bottom: 24px;
}
.profile-avatar-image {
    width: 152px;
    height: 152px;
    overflow: hidden;
    align-items: center;
    justify-content: center;
    background-color: rgb(7, 42, 32);
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-color: rgb(92, 255, 172);
    border-right-color: rgb(92, 255, 172);
    border-top-color: rgb(92, 255, 172);
    border-bottom-color: rgb(92, 255, 172);
    border-top-left-radius: 76px;
    border-top-right-radius: 76px;
    border-bottom-left-radius: 76px;
    border-bottom-right-radius: 76px;
    -unity-background-scale-mode: scale-and-crop;
}
.profile-avatar-initials { font-size: 38px; color: rgb(138, 255, 195); -unity-font-style: bold; }
.profile-avatar-button {
    height: 38px;
    margin-top: 10px;
    padding-left: 16px;
    padding-right: 16px;
    color: rgb(132, 244, 185);
    background-color: transparent;
    border-width: 0;
    font-size: 10px;
    letter-spacing: 1px;
}
.profile-display-name { margin-top: 5px; font-size: 30px; color: rgb(239, 255, 246); -unity-font-style: bold; }
.profile-identity-code { margin-top: 4px; font-size: 10px; letter-spacing: 2px; color: rgba(157, 222, 190, 0.55); }
.profile-stats-grid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.profile-stat-card {
    width: 49%;
    min-height: 112px;
    margin-bottom: 12px;
    align-items: center;
    justify-content: center;
    background-color: rgba(4, 27, 23, 0.88);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(93, 255, 171, 0.2);
    border-right-color: rgba(93, 255, 171, 0.2);
    border-top-color: rgba(93, 255, 171, 0.2);
    border-bottom-color: rgba(93, 255, 171, 0.2);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
}
.profile-stat-value { font-size: 27px; color: rgb(248, 255, 250); -unity-font-style: bold; }
.profile-rank-value { font-size: 17px; color: rgb(255, 215, 87); }
.profile-joined-value { font-size: 18px; }
.profile-stat-label { margin-top: 7px; font-size: 9px; letter-spacing: 2px; color: rgba(145, 226, 184, 0.58); }
.profile-name-editor { margin-top: 16px; padding-top: 18px; border-top-width: 1px; border-top-color: rgba(93, 255, 171, 0.16); }
.profile-minimal-label { margin-bottom: 7px; font-size: 9px; letter-spacing: 2px; color: rgba(145, 226, 184, 0.58); }
.profile-save-button {
    height: 48px;
    margin-top: 9px;
    color: rgb(3, 31, 19);
    background-color: rgb(97, 255, 169);
    border-width: 0;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    font-size: 13px;
    -unity-font-style: bold;
}
.profile-minimal-message { min-height: 24px; margin-top: 7px; }
.profile-account-spacer { min-height: 24px; flex-grow: 1; }
.profile-account-button {
    height: 52px;
    margin-top: 12px;
    color: rgba(178, 232, 204, 0.7);
    background-color: transparent;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(111, 213, 164, 0.25);
    border-right-color: rgba(111, 213, 164, 0.25);
    border-top-color: rgba(111, 213, 164, 0.25);
    border-bottom-color: rgba(111, 213, 164, 0.25);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    font-size: 11px;
    letter-spacing: 2px;
}
.profile-account-menu {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 7, 7, 0.88);
}
.profile-account-sheet {
    width: 78%;
    padding: 25px;
    background-color: rgb(5, 29, 24);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(106, 255, 176, 0.4);
    border-right-color: rgba(106, 255, 176, 0.4);
    border-top-color: rgba(106, 255, 176, 0.4);
    border-bottom-color: rgba(106, 255, 176, 0.4);
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 18px;
}
.profile-account-title { font-size: 26px; color: rgb(235, 255, 244); -unity-font-style: bold; }
.profile-account-subtitle { margin-top: 5px; margin-bottom: 18px; font-size: 9px; letter-spacing: 2px; color: rgba(155, 225, 188, 0.55); }
.profile-account-action { height: 56px; margin-top: 8px; color: rgb(210, 255, 229); background-color: rgba(13, 55, 42, 0.9); border-width: 0; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px; }
.profile-delete-action { color: rgb(255, 145, 126); background-color: rgba(72, 24, 20, 0.85); }
.profile-account-cancel { height: 44px; margin-top: 14px; color: rgba(177, 231, 202, 0.7); background-color: transparent; border-width: 0; }
.profile-name-row {
    margin-top: 5px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}
.profile-name-row .profile-display-name { margin-top: 0; }
.profile-edit-button {
    position: relative;
    width: 56px;
    height: 56px;
    margin-left: 12px;
    padding: 0;
    color: rgb(126, 255, 184);
    background-color: rgba(10, 55, 39, 0.92);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(112, 255, 178, 0.55);
    border-right-color: rgba(112, 255, 178, 0.55);
    border-top-color: rgba(112, 255, 178, 0.55);
    border-bottom-color: rgba(112, 255, 178, 0.55);
    border-top-left-radius: 28px;
    border-top-right-radius: 28px;
    border-bottom-left-radius: 28px;
    border-bottom-right-radius: 28px;
}
.profile-pencil-stroke {
    position: absolute;
    left: 13px;
    top: 24px;
    width: 31px;
    height: 8px;
    rotate: -42deg;
    background-color: rgb(153, 255, 199);
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
}
.profile-pencil-tip {
    position: absolute;
    left: 9px;
    top: 34px;
    width: 8px;
    height: 8px;
    rotate: -42deg;
    background-color: rgb(255, 215, 91);
}
.profile-pencil-eraser {
    position: absolute;
    left: 38px;
    top: 13px;
    width: 8px;
    height: 8px;
    rotate: -42deg;
    background-color: rgb(242, 255, 247);
}
.profile-edit-sheet { width: 84%; padding: 28px; }
.profile-edit-header {
    margin-bottom: 22px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}
.profile-edit-close {
    width: 50px;
    height: 50px;
    padding: 0;
    font-size: 30px;
    color: rgb(136, 255, 191);
    background-color: rgba(11, 57, 42, 0.92);
    border-width: 0;
    border-top-left-radius: 25px;
    border-top-right-radius: 25px;
    border-bottom-left-radius: 25px;
    border-bottom-right-radius: 25px;
}
.profile-edit-avatar-button {
    height: 58px;
    margin-top: 0;
    margin-bottom: 22px;
    font-size: 18px;
    color: rgb(204, 255, 226);
    background-color: rgba(13, 58, 43, 0.92);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(112, 255, 178, 0.42);
    border-right-color: rgba(112, 255, 178, 0.42);
    border-top-color: rgba(112, 255, 178, 0.42);
    border-bottom-color: rgba(112, 255, 178, 0.42);
    border-top-left-radius: 11px;
    border-top-right-radius: 11px;
    border-bottom-left-radius: 11px;
    border-bottom-right-radius: 11px;
}
.profile-edit-label { margin-bottom: 10px; font-size: 16px; }
.profile-edit-input { min-height: 58px; font-size: 18px; }
.profile-edit-save { height: 58px; margin-top: 12px; font-size: 18px; }
.profile-edit-message { min-height: 32px; margin-top: 10px; font-size: 15px; }
.profile-edit-divider { height: 1px; margin-top: 8px; margin-bottom: 14px; background-color: rgba(112, 255, 178, 0.2); }
.profile-edit-sheet .profile-delete-action { height: 60px; font-size: 18px; }
.online-bottom-nav {
    height: 190px;
    min-height: 190px;
    flex-shrink: 0;
    padding-top: 4px;
    padding-bottom: 0;
    flex-direction: row;
    align-items: stretch;
    overflow: hidden;
    background-color: rgb(2, 17, 13);
    border-top-width: 1px;
    border-top-color: rgba(76, 255, 153, 0.24);
}
.online-tab-indicator {
    position: absolute;
    left: 40%;
    top: 0;
    width: 20%;
    height: 4px;
    background-color: rgb(78, 255, 153);
    transition-property: left;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}
.online-tab-button {
    width: auto;
    min-width: 0;
    flex-basis: 20%;
    flex-grow: 1;
    flex-shrink: 1;
    height: 100%;
    margin: 0;
    padding: 8px 0 12px 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    letter-spacing: 1px;
    white-space: normal;
    color: rgba(137, 213, 171, 0.48);
    background-color: transparent;
    border-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    overflow: hidden;
    transition-property: color, background-color;
    transition-duration: 0.14s;
}
.online-tab-icon {
    width: 122px;
    height: 122px;
    flex-shrink: 0;
    opacity: 0.78;
    -unity-background-scale-mode: scale-to-fit;
    transition-property: opacity, scale;
    transition-duration: 0.16s;
}
.tab-icon-shop { background-image: url("project://database/Assets/Art/NavalCommand/generated-asset-pack/tab-icon-shop.png"); }
.tab-icon-friends { background-image: url("project://database/Assets/Art/NavalCommand/generated-asset-pack/tab-icon-friends.png"); }
.tab-icon-play { background-image: url("project://database/Assets/Art/NavalCommand/generated-asset-pack/tab-icon-play.png"); }
.tab-icon-leaderboard {
    width: 108px;
    height: 116px;
    background-image: url("project://database/Assets/Art/NavalCommand/generated-asset-pack/tab-icon-leaderboard.png");
}
.tab-icon-account { background-image: url("project://database/Assets/Art/NavalCommand/generated-asset-pack/tab-icon-account.png"); }
.online-tab-label { margin-top: -2px; font-size: 14px; letter-spacing: 1px; color: rgba(143, 220, 178, 0.76); -unity-font-style: bold; }
.online-tab-active .online-tab-icon { opacity: 1; scale: 1.1 1.1; }
.online-tab-active .tab-icon-leaderboard { scale: 1 1; }
.online-tab-active .online-tab-label { color: rgb(122, 255, 182); }
.online-tab-button-main { color: rgba(136, 247, 185, 0.72); background-color: rgba(8, 43, 29, 0.7); }
.online-tab-button-main .online-tab-icon { width: 138px; height: 138px; }
.online-tab-active { color: rgb(113, 255, 177); background-color: rgba(15, 62, 39, 0.72); }

/* Spielen // Einsatzdeck im Stil eines mobilen Battle-Hubs */
.play-screen {
    background-color: rgba(1, 10, 13, 0.76);
}
.play-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    opacity: 0.42;
    background-image: url("project://database/Assets/Art/NavalCommand/generated-asset-pack/main-menu-command-deck.png");
    -unity-background-scale-mode: scale-and-crop;
    -unity-background-image-tint-color: rgb(47, 150, 127);
}
.play-tab-scroll {
    position: relative;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 18px;
    padding-bottom: 30px;
}
.play-profile-strip {
    min-height: 118px;
    margin-bottom: 14px;
    padding: 14px 16px;
    background-color: rgba(4, 25, 31, 0.95);
    border-left-width: 3px;
    border-left-color: rgb(84, 255, 177);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgba(113, 220, 206, 0.28);
    border-right-color: rgba(113, 220, 206, 0.18);
    border-bottom-color: rgba(113, 220, 206, 0.18);
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 18px;
}
.play-rank-emblem {
    width: 78px;
    height: 78px;
    margin-right: 14px;
    background-color: rgb(6, 45, 42);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 208, 77, 0.78);
    border-right-color: rgba(255, 208, 77, 0.78);
    border-top-color: rgba(255, 208, 77, 0.78);
    border-bottom-color: rgba(255, 208, 77, 0.78);
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 18px;
    rotate: -4deg;
    overflow: hidden;
}
.play-rank-emblem-art {
    width: 74px;
    height: 74px;
    background-image: url("project://database/Assets/Art/NavalCommand/generated-asset-pack/naval-command-emblem.png");
    -unity-background-scale-mode: scale-to-fit;
    rotate: 4deg;
}
.play-profile-copy { justify-content: center; }
.play-kicker {
    margin-bottom: 3px;
    font-size: 10px;
    letter-spacing: 2px;
    color: rgba(126, 238, 194, 0.58);
    -unity-font-style: bold;
}
.play-profile-strip .online-profile-name {
    font-size: 22px;
    letter-spacing: 2px;
    color: rgb(228, 255, 237);
}
.play-profile-strip .online-rank { margin-top: 4px; color: rgb(255, 212, 93); }
.play-profile-strip .micro-label { margin-top: 5px; font-size: 10px; }
.play-profile-strip .profile-code-chip {
    align-self: flex-start;
    margin-left: 8px;
    padding: 7px 9px;
    color: rgba(154, 230, 209, 0.7);
    background-color: rgba(0, 11, 14, 0.78);
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
}
.play-season-card {
    min-height: 135px;
    margin-bottom: 14px;
    padding: 18px 18px 16px 20px;
    flex-direction: row;
    background-color: rgba(8, 43, 46, 0.93);
    border-left-width: 4px;
    border-left-color: rgb(255, 207, 69);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgba(255, 221, 112, 0.48);
    border-right-color: rgba(255, 221, 112, 0.2);
    border-bottom-color: rgba(255, 221, 112, 0.2);
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
}
.play-season-copy { flex-grow: 1; justify-content: center; }
.play-season-card .battle-season { font-size: 10px; letter-spacing: 2px; color: rgb(255, 217, 99); }
.play-season-title {
    margin-top: 5px;
    font-size: 23px;
    letter-spacing: 2px;
    color: rgb(231, 255, 244);
    -unity-font-style: bold;
}
.play-season-subtitle {
    margin-top: 5px;
    font-size: 10px;
    letter-spacing: 1px;
    color: rgba(185, 235, 216, 0.62);
    white-space: normal;
}
.play-season-badge {
    width: 94px;
    height: 94px;
    margin-left: 16px;
    align-items: center;
    justify-content: center;
    background-color: rgba(4, 24, 27, 0.46);
    border-top-left-radius: 47px;
    border-top-right-radius: 47px;
    border-bottom-left-radius: 47px;
    border-bottom-right-radius: 47px;
}
.play-season-badge-art {
    width: 82px;
    height: 82px;
    background-image: url("project://database/Assets/Art/NavalCommand/generated-asset-pack/naval-command-emblem.png");
    -unity-background-scale-mode: scale-to-fit;
}
.play-arena-card {
    position: relative;
    min-height: 486px;
    padding: 22px;
    justify-content: flex-end;
    overflow: hidden;
    background-color: rgb(3, 38, 47);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(72, 255, 194, 0.72);
    border-right-color: rgba(72, 255, 194, 0.32);
    border-top-color: rgba(72, 255, 194, 0.72);
    border-bottom-color: rgba(72, 255, 194, 0.32);
    border-top-left-radius: 24px;
    border-top-right-radius: 24px;
    border-bottom-left-radius: 24px;
    border-bottom-right-radius: 24px;
}
.play-arena-ocean {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    opacity: 0.88;
    background-image: url("project://database/Assets/Art/NavalCommand/generated-asset-pack/tactical-ocean-surface.png");
    -unity-background-scale-mode: scale-and-crop;
}
.play-arena-vignette {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 18, 24, 0.4);
}
.play-arena-grid {
    position: absolute;
    left: 12%;
    right: 12%;
    top: 15%;
    height: 48%;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(157, 255, 224, 0.24);
    border-right-color: rgba(157, 255, 224, 0.24);
    border-top-color: rgba(157, 255, 224, 0.24);
    border-bottom-color: rgba(157, 255, 224, 0.24);
}
.play-arena-grid-line { position: absolute; background-color: rgba(157, 255, 224, 0.22); }
.play-arena-grid-line-v { left: 50%; top: 0; bottom: 0; width: 1px; }
.play-arena-grid-line-h { left: 0; right: 0; top: 50%; height: 1px; }
.play-commander-portrait {
    position: absolute;
    right: -16px;
    top: 17px;
    width: 174px;
    height: 198px;
    opacity: 0.86;
    background-image: url("project://database/Assets/Art/NavalCommand/captain-portraits/01-male-veteran-commander.png");
    -unity-background-scale-mode: scale-and-crop;
    border-bottom-left-radius: 70px;
}
.play-hero-ship {
    position: absolute;
    left: 7%;
    right: 7%;
    top: 35%;
    height: 86px;
    opacity: 0.85;
    background-image: url("project://database/Assets/Art/NavalCommand/individual-ships/grid-ready-128/09-aircraft-carrier-5x1.png");
    -unity-background-scale-mode: scale-to-fit;
}
.play-arena-copy { position: absolute; left: 22px; top: 24px; }
.play-arena-kicker { font-size: 10px; letter-spacing: 3px; color: rgba(217, 255, 239, 0.68); -unity-font-style: bold; }
.play-arena-title { margin-top: 5px; font-size: 28px; letter-spacing: 3px; color: rgb(237, 255, 244); -unity-font-style: bold; }
.play-arena-caption { margin-top: 4px; font-size: 10px; letter-spacing: 1px; color: rgba(223, 255, 239, 0.72); }
.play-arena-card .play-launch-center { position: relative; }
.play-launch-button {
    width: 148px;
    height: 148px;
    padding-left: 12px;
    font-size: 57px;
    color: rgb(2, 33, 34);
    background-color: rgb(255, 203, 61);
    border-left-width: 8px;
    border-right-width: 8px;
    border-top-width: 8px;
    border-bottom-width: 8px;
    border-left-color: rgba(255, 245, 182, 0.48);
    border-right-color: rgba(197, 135, 26, 0.66);
    border-top-color: rgba(255, 245, 182, 0.48);
    border-bottom-color: rgba(197, 135, 26, 0.66);
    border-top-left-radius: 74px;
    border-top-right-radius: 74px;
    border-bottom-left-radius: 74px;
    border-bottom-right-radius: 74px;
    -unity-font-style: bold;
    transition-property: scale, background-color;
    transition-duration: 0.12s;
}
.play-launch-button:hover { scale: 1.06 1.06; background-color: rgb(255, 225, 107); }
.play-launch-caption { margin-top: 12px; font-size: 13px; letter-spacing: 3px; color: rgb(240, 255, 246); -unity-font-style: bold; }
.play-arena-card .mode-selector-button {
    height: 58px;
    margin-top: 18px;
    font-size: 13px;
    color: rgb(227, 255, 240);
    background-color: rgba(1, 25, 31, 0.9);
    border-left-color: rgba(133, 255, 211, 0.6);
    border-right-color: rgba(133, 255, 211, 0.6);
    border-top-color: rgba(133, 255, 211, 0.6);
    border-bottom-color: rgba(133, 255, 211, 0.6);
}
.play-arena-card .mode-selector-hint { margin-top: 7px; color: rgba(206, 255, 231, 0.52); }
.play-info-row { margin-top: 14px; }
.play-info-card {
    min-height: 78px;
    background-color: rgba(3, 28, 34, 0.92);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(104, 255, 193, 0.24);
    border-right-color: rgba(104, 255, 193, 0.12);
    border-top-color: rgba(104, 255, 193, 0.24);
    border-bottom-color: rgba(104, 255, 193, 0.12);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}
.play-info-value { font-size: 14px; color: rgb(255, 215, 91); }
.play-info-label { color: rgba(174, 237, 215, 0.6); }
.play-quick-actions { flex-direction: row; margin-top: 8px; }
.play-quick-action { width: 50%; margin-right: 7px; color: rgba(156, 247, 207, 0.8); background-color: rgba(2, 22, 28, 0.7); border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgba(101, 255, 192, 0.22); border-right-color: rgba(101, 255, 192, 0.12); border-top-color: rgba(101, 255, 192, 0.22); border-bottom-color: rgba(101, 255, 192, 0.12); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px; }

/* Spielen // freie Elemente auf dem Hintergrund */
.play-screen {
    position: absolute;
    overflow: hidden;
    background-color: rgb(1, 10, 12);
}
.play-screen .play-backdrop {
    opacity: 0.58;
    -unity-background-image-tint-color: rgb(74, 151, 135);
}
.play-profile-free {
    position: absolute;
    left: 5%;
    right: 5%;
    top: 3%;
    height: 102px;
    flex-direction: row;
    align-items: center;
    background-color: transparent;
    border-width: 0;
}
.play-profile-free .play-rank-emblem-art {
    width: 88px;
    height: 88px;
    margin-right: 16px;
    rotate: 0deg;
    opacity: 0.96;
}
.play-profile-free .play-profile-copy {
    flex-grow: 1;
    justify-content: center;
}
.play-profile-free .online-profile-name {
    font-size: 25px;
    letter-spacing: 2px;
    color: rgb(236, 255, 244);
    -unity-font-style: bold;
}
.play-profile-free .online-rank {
    margin-top: 5px;
    font-size: 14px;
    letter-spacing: 1px;
    color: rgb(255, 211, 82);
    -unity-font-style: bold;
}
.play-profile-free .micro-label {
    margin-top: 6px;
    font-size: 10px;
    letter-spacing: 1px;
    color: rgba(156, 239, 199, 0.72);
}
.profile-code-free {
    align-self: flex-start;
    margin-top: 10px;
    margin-left: 14px;
    font-size: 10px;
    letter-spacing: 1px;
    color: rgba(166, 235, 208, 0.62);
}
.play-season-free {
    position: absolute;
    left: 6%;
    top: 14%;
    font-size: 11px;
    letter-spacing: 3px;
    color: rgb(255, 214, 89);
    -unity-font-style: bold;
}
.play-fleet-arena-art {
    position: absolute;
    left: 5%;
    right: 5%;
    top: 18%;
    height: 35%;
    background-image: url("project://database/Assets/Art/NavalCommand/generated-asset-pack/play-hub-fleet-arena.png");
    -unity-background-scale-mode: scale-to-fit;
}
.play-mode-button {
    position: absolute;
    left: 20%;
    right: 20%;
    top: 55%;
    height: 62px;
    margin: 0;
    color: rgb(227, 255, 240);
    background-color: rgba(2, 29, 34, 0.88);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(94, 255, 187, 0.72);
    border-right-color: rgba(94, 255, 187, 0.72);
    border-top-color: rgba(94, 255, 187, 0.72);
    border-bottom-color: rgba(94, 255, 187, 0.72);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    font-size: 14px;
    letter-spacing: 2px;
    -unity-font-style: bold;
}
.play-mode-hint {
    position: absolute;
    left: 20%;
    right: 20%;
    top: 62%;
    margin: 0;
    -unity-text-align: middle-center;
    font-size: 9px;
    letter-spacing: 2px;
    color: rgba(167, 230, 204, 0.56);
}
.play-login-suppressed { display: none; }
.play-battle-button {
    position: absolute;
    left: 14%;
    right: 14%;
    top: 66%;
    width: auto;
    height: 150px;
    margin: 0;
    padding: 0;
    font-size: 31px;
    letter-spacing: 4px;
    color: rgb(255, 255, 239);
    background-color: transparent;
    /* Cropped from JellyCat's "Gold GUI" (CC0): https://opengameart.org/content/gold-gui */
    background-image: url("project://database/Assets/Art/NavalCommand/generated-asset-pack/play-primary-button-frame.png");
    -unity-background-scale-mode: scale-to-fit;
    border-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    -unity-font-style: bold;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(34, 20, 4);
    transition-property: scale, opacity;
    transition-duration: 0.12s;
}
.play-battle-button:hover {
    scale: 1.04 1.04;
    opacity: 1;
    background-color: transparent;
}
.play-battle-button:active {
    scale: 0.98 0.98;
    opacity: 0.9;
    background-color: transparent;
}

.developer-admin-panel {
    position: absolute;
    right: 4%;
    top: 15%;
    width: 330px;
    padding: 15px;
    background-color: rgba(3, 24, 29, 0.96);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(255, 199, 62);
    border-right-color: rgb(255, 199, 62);
    border-top-color: rgb(255, 199, 62);
    border-bottom-color: rgb(255, 199, 62);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
}
.developer-admin-header {
    margin-bottom: 10px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}
.developer-admin-title {
    font-size: 20px;
    letter-spacing: 2px;
    color: rgb(255, 215, 92);
    -unity-font-style: bold;
}
.developer-admin-account {
    font-size: 9px;
    letter-spacing: 1px;
    color: rgba(171, 255, 213, 0.72);
}
.developer-admin-toggle {
    height: 46px;
    margin-top: 5px;
    padding-left: 9px;
    padding-right: 9px;
    color: rgb(201, 255, 225);
    background-color: rgba(0, 12, 16, 0.76);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(90, 255, 176, 0.3);
    border-right-color: rgba(90, 255, 176, 0.3);
    border-top-color: rgba(90, 255, 176, 0.3);
    border-bottom-color: rgba(90, 255, 176, 0.3);
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
    font-size: 12px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}
.developer-admin-toggle .unity-toggle__input {
    width: 38px;
    height: 26px;
    margin-right: 10px;
    background-color: rgb(3, 30, 27);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(95, 255, 179, 0.5);
    border-right-color: rgba(95, 255, 179, 0.5);
    border-top-color: rgba(95, 255, 179, 0.5);
    border-bottom-color: rgba(95, 255, 179, 0.5);
}
.developer-admin-toggle:checked {
    color: rgb(255, 222, 112);
    background-color: rgba(80, 54, 5, 0.7);
}
.developer-admin-toggle:checked .unity-toggle__input {
    background-color: rgb(255, 190, 50);
    border-left-color: rgb(255, 226, 128);
    border-right-color: rgb(255, 226, 128);
    border-top-color: rgb(255, 226, 128);
    border-bottom-color: rgb(255, 226, 128);
}

/* Clash-inspirierte Display-Schrift: Lilita One (SIL OFL 1.1) */
.online-hub-screen {
    -unity-font-definition: url("project://database/Assets/UI/Fonts/LilitaOne-Regular.ttf");
}
.online-app-title,
.play-profile-free .online-profile-name,
.play-profile-free .online-rank,
.play-season-free,
.play-mode-button,
.play-battle-button,
.online-tab-label,
.game-mode-title,
.game-mode-option {
    -unity-font-style: normal;
}
.online-app-title { letter-spacing: 1px; }
.play-profile-free .online-profile-name { letter-spacing: 1px; }
.play-profile-free .online-rank { letter-spacing: 0; }
.play-season-free { letter-spacing: 1px; }
.play-mode-button { letter-spacing: 1px; }
.play-battle-button {
    font-size: 36px;
    letter-spacing: 1px;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(65, 40, 6);
}
.online-tab-label { letter-spacing: 0; }
.game-mode-title,
.game-mode-option { letter-spacing: 1px; }

/* ABYSS commander cinematics */
.ability-cinematic-abyss-torpedo .ability-ocean-grade,
.ability-cinematic-abyss-submerge .ability-ocean-grade {
    background-color: rgba(0, 35, 58, 0.46);
}

/* Lesbarkeit // klare Mindestgroessen fuer die mobile Oberflaeche */
.tutorial-replay-button {
    height: 44px;
    font-size: 20px;
    letter-spacing: 1px;
}
.online-app-title { font-size: 28px; }
.online-live-label { font-size: 17px; letter-spacing: 1px; }
.friend-state { font-size: 16px; color: rgba(117, 255, 177, 0.72); }
.featured-offer-subtitle,
.featured-content-name,
.featured-price-note,
.tab-hero-copy,
.shop-card-subtitle,
.shop-card-feature,
.tab-subheading,
.field-hint,
.profile-avatar-button,
.profile-identity-code,
.profile-stat-label,
.profile-minimal-label {
    font-size: 16px;
    letter-spacing: 1px;
}
.section-label,
.shop-buy-button,
.online-tab-button,
.developer-admin-toggle {
    font-size: 16px;
}
.section-label { letter-spacing: 2px; }
.online-tab-label { font-size: 23px; }
.play-profile-free .online-profile-name { font-size: 30px; }
.play-profile-free .online-rank { font-size: 20px; }
.play-profile-free .micro-label { font-size: 20px; }
.play-mode-button { font-size: 20px; }
.developer-admin-title { font-size: 23px; }
.developer-admin-toggle { font-size: 18px; }
.shop-banner-copy,
.battle-meta,
.play-info-label,
.profile-code-chip { font-size: 15px; }
.field-label,
.leaderboard-column-labels,
.profile-account-button,
.profile-account-action,
.profile-account-cancel,
.online-message { font-size: 16px; }

/* Anmeldung // auf kleinen Displays deutlich lesbarer */
#OnlineLoginScreen .screen-title { font-size: 30px; }
#OnlineLoginScreen .online-title { font-size: 42px; }
#OnlineLoginScreen .online-copy { font-size: 23px; }
#OnlineLoginScreen .online-consent { height: 64px; font-size: 19px; }
#OnlineLoginScreen .online-wide-button { min-height: 76px; font-size: 23px; }
#OnlineLoginScreen .online-message { min-height: 32px; font-size: 18px; }
.web-credentials { width: 100%; }
.web-credential-input { width: 100%; }
.web-credential-input .unity-base-field__label {
    min-width: 150px;
    color: rgb(169, 244, 204);
    font-size: 18px;
}
.web-credential-hint { margin-bottom: 4px; font-size: 16px; white-space: normal; }

/* Menüs // einheitliche, gut lesbare Mindestgrößen */
.topbar-button { font-size: 18px; }
.tutorial-menu-button { height: 48px; font-size: 18px; }
.tutorial-replay-button,
.play-mode-button,
.online-tab-label { font-size: 25px; }
.secondary-button { font-size: 20px; }
.micro-label { font-size: 18px; }
.online-app-title { font-size: 32px; }
.online-message { font-size: 18px; }
.featured-offer-subtitle,
.featured-content-name,
.featured-price-note,
.shop-banner-copy,
.shop-card-subtitle,
.shop-card-feature,
.reward-code-copy,
.tab-hero-copy,
.tab-subheading,
.field-hint,
.profile-code-chip,
.battle-season,
.battle-meta,
.play-launch-caption,
.mode-selector-hint,
.game-mode-subtitle,
.play-info-label,
.profile-tagline,
.field-label,
.profile-identity-code,
.profile-stat-label,
.profile-minimal-label,
.profile-account-subtitle,
.leaderboard-column-labels,
.developer-admin-account { font-size: 20px; }
.section-label { font-size: 20px; }
.featured-offer-ribbon-text { font-size: 26px; }
.featured-offer-title { font-size: 30px; }
.rewarded-commander-title { font-size: 27px; }
.shop-card-title { font-size: 24px; }
.shop-buy-button,
.rewarded-ad-button,
.solo-battle-button,
.text-link-button { font-size: 20px; }
.tab-heading { font-size: 32px; }
.game-mode-option { font-size: 21px; }
.friend-name { font-size: 22px; }
.friend-state,
.friend-action { font-size: 19px; }
.profile-identity-code,
.profile-stat-label,
.profile-minimal-label { font-size: 20px; }
.profile-account-action,
