    border-right-width: 3px;
    border-left-color: rgba(122, 241, 255, 0.44);
    border-right-color: rgba(122, 241, 255, 0.44);
    transition-property: opacity, rotate;
    transition-duration: 0.92s;
    transition-timing-function: ease-in-out;
}
.oracle-sky-beam-core {
    position: absolute;
    left: 44%;
    top: 0;
    bottom: 0;
    width: 12%;
    background-color: rgba(176, 252, 255, 0.78);
}
.oracle-scan-active .oracle-sky-beam {
    opacity: 0.88;
}
.oracle-pendulum-right .oracle-sky-beam {
    rotate: 16deg;
}
.oracle-contact .oracle-distant-ship {
    -unity-background-image-tint-color: rgb(255, 118, 92);
}
.oracle-contact .ability-cinematic-result {
    color: rgb(255, 125, 97);
    border-left-color: rgba(255, 100, 76, 0.7);
    border-right-color: rgba(255, 100, 76, 0.7);
    border-top-color: rgba(255, 100, 76, 0.7);
    border-bottom-color: rgba(255, 100, 76, 0.7);
}

.ares-ocean-stage {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    overflow: hidden;
}
.ares-ship-shadow {
    position: absolute;
    left: -3%;
    right: -3%;
    bottom: 1%;
    height: 42%;
    opacity: 0.42;
    background-color: rgba(0, 5, 10, 0.74);
}
.ares-blue-glow {
    position: absolute;
    left: -4%;
    right: -4%;
    bottom: 0;
    height: 49%;
    opacity: 0;
    scale: 0.92 0.92;
    background-color: rgba(45, 181, 255, 0.42);
    border-left-width: 12px;
    border-right-width: 12px;
    border-top-width: 12px;
    border-bottom-width: 12px;
    border-left-color: rgba(119, 225, 255, 0.65);
    border-right-color: rgba(119, 225, 255, 0.65);
    border-top-color: rgba(119, 225, 255, 0.65);
    border-bottom-color: rgba(119, 225, 255, 0.65);
