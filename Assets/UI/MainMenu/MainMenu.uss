.raptor-window-jet {
    position: absolute;
    left: -48%;
    top: 34%;
    width: 46%;
    height: 18%;
    opacity: 1;
    background-image: url("project://database/Assets/Art/NavalCommand/effects/raptor-jet-side.png");
    -unity-background-scale-mode: scale-to-fit;
    transition-property: left;
    transition-duration: 0.575s;
    transition-timing-function: linear;
}
.raptor-pass-active .raptor-window-jet { left: 108%; }
.ability-cinematic-raptor-jet-start .ability-cinematic-result {
    bottom: 5%;
    color: rgb(103, 255, 177);
    border-left-color: rgba(72, 255, 153, 0.58);
    border-right-color: rgba(72, 255, 153, 0.58);
    border-top-color: rgba(72, 255, 153, 0.58);
    border-bottom-color: rgba(72, 255, 153, 0.58);
}

/* Normal-shot cinematic */
.shot-cinematic {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    overflow: hidden;
    opacity: 1;
    background-color: rgb(1, 7, 9);
    color: rgb(111, 255, 166);
}
.shot-visible { opacity: 1; }
.shot-finish { opacity: 0; }

.shot-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    opacity: 1;
    scale: 1 1;
    background-image: url("project://database/Assets/Art/NavalCommand/shot-animation/shot-ocean-bg.png");
    -unity-background-scale-mode: scale-and-crop;
}
.shot-visible .shot-backdrop { opacity: 1; }

.shot-color-grade {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 24, 19, 0.16);
}
.shot-vignette {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 12%;
    background-color: rgba(0, 4, 6, 0.27);
}
.shot-vignette-left { left: 0; }
.shot-vignette-right { right: 0; }

.shot-enemy-ship {
    position: absolute;
    left: 36%;
    width: 28%;
    height: 10%;
    top: 42%;
    opacity: 1;
    translate: 0 0;
    scale: 1 1;
    background-image: url("project://database/Assets/Art/NavalCommand/shot-animation/shot-enemy-frigate.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(205, 229, 231);
    transition-property: translate, rotate, -unity-background-image-tint-color;
    transition-duration: 0.07s;
}
.shot-impact-hit .shot-enemy-ship {
    translate: 4px 3px;
    rotate: 0.45deg;
    -unity-background-image-tint-color: rgb(255, 157, 141);
    transition-duration: 0.07s;
}
.shot-enemy-attacker {
    position: absolute;
    left: 10%;
    right: 10%;
    top: 34%;
    height: 24%;
    opacity: 0;
    background-image: url("project://database/Assets/Art/NavalCommand/shot-animation/shot-enemy-close-destroyer.png");
    -unity-background-scale-mode: scale-to-fit;
}
.shot-incoming .shot-enemy-ship { opacity: 0; }
.shot-incoming .shot-enemy-attacker { opacity: 1; }

.shot-raptor-jet {
    position: absolute;
    left: -34%;
    top: 23%;
    width: 32%;
    height: 14%;
    opacity: 0;
    background-image: url("project://database/Assets/Art/NavalCommand/effects/raptor-jet-side.png");
    -unity-background-scale-mode: scale-to-fit;
    transition-property: left, top, opacity, rotate, scale;
    transition-duration: 0.525s, 0.525s, 0.1s, 0.12s, 0.12s;
    transition-timing-function: linear;
}
.shot-jet-active.shot-cut .shot-raptor-jet {
    left: 112%;
    opacity: 1;
}
.shot-jet-struck .shot-raptor-jet {
    opacity: 1;
    rotate: 0deg;
    scale: 1 1;
    transition-duration: 0.42s, 0.42s, 0.3s, 0.42s, 0.42s;
}
.shot-jet-struck.shot-impact-hit .shot-raptor-jet {
    opacity: 0.08;
    rotate: 22deg;
    scale: 0.68 0.68;
}

.shot-water-haze {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 29%;
    background-color: rgba(0, 19, 22, 0.18);
}

.shot-missile {
    position: absolute;
    width: 30px;
    height: 104px;
    margin-left: -15px;
    opacity: 0;
}
.shot-missile-sprite {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("project://database/Assets/Art/NavalCommand/shot-animation/shot-missile.png");
    -unity-background-scale-mode: scale-to-fit;
}
.shot-missile-trail {
    position: absolute;
    left: 13px;
    top: 86px;
    width: 4px;
    height: 150px;
    background-color: rgba(182, 255, 226, 0.44);
    border-left-width: 1px;
    border-right-width: 1px;
    border-left-color: rgba(77, 255, 164, 0.36);
    border-right-color: rgba(77, 255, 164, 0.36);
}
.shot-missile-flame {
    position: absolute;
    left: 11px;
    top: 86px;
    width: 8px;
    height: 24px;
    background-color: rgba(255, 202, 91, 0.92);
    border-left-width: 1px;
    border-right-width: 1px;
    border-left-color: rgba(67, 255, 151, 0.54);
    border-right-color: rgba(67, 255, 151, 0.54);
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
}
.shot-fire-particle {
    position: absolute;
    top: 94px;
    width: 7px;
    height: 16px;
    opacity: 0;
    background-color: rgb(255, 188, 67);
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
    transition-property: opacity, translate, scale;
    transition-duration: 0.48s;
}
.shot-fire-particle-1 { left: 4px; }
.shot-fire-particle-2 { left: 10px; transition-duration: 0.32s; }
.shot-fire-particle-3 { left: 17px; transition-duration: 0.56s; }
.shot-fire-particle-4 { left: 7px; top: 102px; transition-duration: 0.4s; }
.shot-fire-particle-5 { left: 15px; top: 100px; transition-duration: 0.64s; }
.shot-incoming.shot-terminal .shot-fire-particle { opacity: 0.92; translate: -18px 94px; scale: 0.35 0.35; }
.shot-incoming.shot-terminal .shot-fire-particle-2 { translate: 11px 128px; }
.shot-incoming.shot-terminal .shot-fire-particle-3 { translate: 23px 82px; }
.shot-incoming.shot-terminal .shot-fire-particle-4 { translate: -9px 148px; }
.shot-incoming.shot-terminal .shot-fire-particle-5 { translate: 17px 116px; }
.shot-terminal-missile {
    left: 50%;
    top: -140px;
    rotate: 180deg;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.86s;
    transition-timing-function: ease-in;
}
.shot-terminal .shot-terminal-missile {
    opacity: 1;
    translate: 0 1070px;
}
.shot-jet-targeted .shot-terminal-missile {
    top: -12%;
    translate: 0 0;
    transition-property: opacity, top;
    transition-duration: 0.86s, 0.86s;
    transition-timing-function: ease-in;
}
.shot-jet-targeted.shot-terminal .shot-terminal-missile {
    opacity: 1;
    top: 24%;
    translate: 0 0;
}
.shot-impact-hit .shot-terminal-missile,
.shot-impact-miss .shot-terminal-missile {
    opacity: 0;
    transition-duration: 0.05s;
}
.shot-jet-targeted.shot-impact-hit .shot-terminal-missile {
    opacity: 0;
    transition-duration: 0s, 0s;
}
.shot-terminal-trail { height: 150px; }
.shot-incoming .shot-terminal-trail {
    width: 7px;
    left: 11px;
    height: 220px;
    background-color: rgba(255, 154, 55, 0.52);
    border-left-color: rgba(255, 220, 111, 0.74);
    border-right-color: rgba(255, 74, 24, 0.52);
}
.shot-incoming .shot-terminal-missile .shot-missile-flame {
    left: 7px;
    width: 16px;
    height: 46px;
    background-color: rgb(255, 178, 61);
    border-left-color: rgb(255, 238, 159);
    border-right-color: rgb(255, 71, 22);
}

.shot-impact-anchor {
    position: absolute;
    left: 50%;
    top: 59%;
    width: 1px;
    height: 1px;
    overflow: visible;
    transition-property: left, top;
    transition-duration: 0s, 0s;
    transition-timing-function: linear;
}
.shot-jet-struck .shot-impact-anchor {
    transition-duration: 0.42s, 0.42s;
}
.shot-hit-explosion {
    position: absolute;
    left: -150px;
    top: -145px;
    width: 300px;
    height: 220px;
    opacity: 0;
    scale: 0.14 0.14;
    background-image: url("project://database/Assets/Art/NavalCommand/shot-animation/shot-hit-explosion.png");
    -unity-background-scale-mode: scale-to-fit;
    transition-property: opacity, scale, translate;
    transition-duration: 0.22s;
}
.shot-impact-hit .shot-hit-explosion {
    opacity: 1;
    scale: 1 1;
    translate: 0 -12px;
}
.shot-miss-splash {
    position: absolute;
    left: -105px;
    top: -215px;
    width: 210px;
    height: 230px;
    opacity: 0;
    scale: 0.18 0.18;
    background-image: url("project://database/Assets/Art/NavalCommand/shot-animation/shot-water-splash.png");
    -unity-background-scale-mode: scale-to-fit;
    transition-property: opacity, scale, translate;
    transition-duration: 0.28s;
}
.shot-impact-miss .shot-miss-splash {
    opacity: 1;
    scale: 1 1;
    translate: 0 -10px;
}
.shot-impact-flash {
    display: none;
    position: absolute;
    left: -430px;
    top: -430px;
    width: 860px;
    height: 860px;
    border-radius: 50%;
    opacity: 0;
    scale: 0.08 0.08;
    background-color: rgba(255, 132, 62, 0.52);
    transition-property: opacity, scale;
    transition-duration: 0.16s;
}
.shot-impact-hit .shot-impact-flash {
    opacity: 1;
    scale: 1 1;
}
.shot-impact-core {
    display: none;
    position: absolute;
    left: -55px;
    top: -55px;
    width: 110px;
    height: 110px;
    border-radius: 50%;
    opacity: 0;
    scale: 0.1 0.1;
    background-color: rgb(255, 239, 185);
    border-left-width: 18px;
    border-right-width: 18px;
    border-top-width: 18px;
    border-bottom-width: 18px;
    border-left-color: rgb(255, 73, 46);
    border-right-color: rgb(255, 73, 46);
    border-top-color: rgb(255, 73, 46);
    border-bottom-color: rgb(255, 73, 46);
    transition-property: opacity, scale;
    transition-duration: 0.18s;
}
.shot-impact-hit .shot-impact-core {
    opacity: 1;
    scale: 1.8 1.8;
}
.shot-explosion-smoke {
    display: none;
    position: absolute;
    width: 122px;
    height: 122px;
    border-radius: 50%;
    opacity: 0;
    scale: 0.2 0.2;
    background-color: rgba(34, 38, 37, 0.92);
    border-left-width: 7px;
    border-right-width: 7px;
    border-top-width: 7px;
    border-bottom-width: 7px;
    border-left-color: rgba(255, 99, 46, 0.5);
    border-right-color: rgba(255, 99, 46, 0.5);
    border-top-color: rgba(255, 99, 46, 0.5);
    border-bottom-color: rgba(255, 99, 46, 0.5);
    transition-property: opacity, scale, translate;
    transition-duration: 0.5s;
}
.shot-explosion-smoke-1 { left: -112px; top: -165px; }
.shot-explosion-smoke-2 { left: 6px; top: -192px; }
.shot-explosion-smoke-3 { left: -55px; top: -252px; }
.shot-explosion-smoke-4 { left: -22px; top: -105px; }
.shot-impact-hit .shot-explosion-smoke { opacity: 0.92; scale: 1.35 1.35; translate: 0 -48px; }
.shot-impact-hit .shot-explosion-smoke-2 { scale: 1.7 1.7; translate: 36px -72px; }
.shot-impact-hit .shot-explosion-smoke-3 { scale: 1.45 1.45; translate: -28px -98px; }

.shot-debris {
    display: none;
    position: absolute;
    width: 8px;
    height: 92px;
    opacity: 0;
    background-color: rgb(255, 174, 69);
    transition-property: opacity, translate, rotate;
    transition-duration: 0.45s;
}
.shot-debris-1 { left: -22px; top: -40px; rotate: -28deg; }
.shot-debris-2 { left: 16px; top: -38px; rotate: 32deg; }
.shot-debris-3 { left: 42px; top: -22px; rotate: 61deg; }
.shot-impact-hit .shot-debris { opacity: 1; translate: -90px -170px; }
.shot-impact-hit .shot-debris-2 { translate: 85px -210px; }
.shot-impact-hit .shot-debris-3 { translate: 165px -120px; }

.shot-splash-column {
    display: none;
    position: absolute;
    opacity: 0;
    background-color: rgba(191, 248, 246, 0.86);
    border-left-width: 8px;
    border-right-width: 8px;
    border-left-color: rgba(67, 210, 204, 0.54);
    border-right-color: rgba(67, 210, 204, 0.54);
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    scale: 0.18 0.18;
    transition-property: opacity, scale, translate;
    transition-duration: 0.32s;
}
.shot-splash-column-main { left: -34px; top: -250px; width: 68px; height: 250px; }
.shot-splash-column-left { left: -88px; top: -155px; width: 40px; height: 160px; rotate: -16deg; }
.shot-splash-column-right { left: 48px; top: -180px; width: 44px; height: 184px; rotate: 17deg; }
.shot-impact-miss .shot-splash-column { opacity: 0.9; scale: 1 1; translate: 0 -22px; }
.shot-impact-miss .shot-splash-column-left { scale: 0.82 0.82; }
.shot-impact-miss .shot-splash-column-right { scale: 0.9 0.9; }
.shot-result-panel {
    position: absolute;
    left: 9%;
    right: 9%;
    bottom: 7%;
    height: 158px;
    opacity: 0;
    translate: 0 48px;
    align-items: center;
    justify-content: center;
    background-color: rgba(1, 12, 10, 0.88);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(76, 255, 149, 0.45);
    border-right-color: rgba(76, 255, 149, 0.45);
    border-top-color: rgba(76, 255, 149, 0.45);
    border-bottom-color: rgba(76, 255, 149, 0.45);
    transition-property: opacity, translate;
    transition-duration: 0.24s;
}
.shot-impact-hit .shot-result-panel,
.shot-impact-miss .shot-result-panel {
    opacity: 1;
    translate: 0 0;
}
.shot-result-label {
    font-size: 29px;
    letter-spacing: 6px;
    -unity-font-style: bold;
    color: rgb(106, 255, 164);
}
.shot-impact-hit .shot-result-label {
    color: rgb(255, 88, 65);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(255, 50, 32, 0.25);
}
.shot-coordinate-label {
    margin-top: 9px;
    font-size: 12px;
    letter-spacing: 4px;
    color: rgba(118, 228, 170, 0.58);
}
.shot-shake-a { translate: -4px 2px; }
.shot-shake-b { translate: 5px -3px; }
.shot-shake-c { translate: -3px -2px; }

/* Mobile online app shell */
.online-hub-screen {
    padding: 0;
    flex-direction: column;
    overflow: hidden;
    background-color: rgb(1, 8, 7);
}
.online-hub-glow {
    position: absolute;
    left: -20%;
    right: -20%;
    top: -170px;
    height: 390px;
    opacity: 0.55;
    background-color: rgba(20, 122, 72, 0.22);
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
}
.online-app-header {
    height: 112px;
    padding-left: 24px;
    padding-right: 24px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(2, 15, 12, 0.96);
    border-bottom-width: 1px;
    border-bottom-color: rgba(78, 255, 158, 0.22);
}
.online-header-back {
    width: 58px;
    height: 58px;
    margin-right: 17px;
    padding: 0;
    font-size: 36px;
    color: rgb(116, 255, 181);
    background-color: rgba(7, 35, 25, 0.9);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(86, 255, 165, 0.28);
    border-right-color: rgba(86, 255, 165, 0.28);
    border-top-color: rgba(86, 255, 165, 0.28);
    border-bottom-color: rgba(86, 255, 165, 0.28);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
}
.online-header-copy { flex-grow: 1; }
.online-app-title {
    font-size: 23px;
    letter-spacing: 4px;
    color: rgb(135, 255, 191);
    -unity-font-style: bold;
}
.online-app-status {
    margin-top: 4px;
    font-size: 10px;
    letter-spacing: 2px;
    color: rgba(126, 227, 173, 0.54);
}
.online-header-signal {
    flex-direction: row;
    align-items: center;
    padding-left: 13px;
    padding-right: 13px;
    height: 36px;
    background-color: rgba(7, 40, 27, 0.8);
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 18px;
}
.online-signal-dot {
    width: 8px;
    height: 8px;
    margin-right: 7px;
    background-color: rgb(80, 255, 152);
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
}
.online-live-label { font-size: 10px; letter-spacing: 2px; color: rgb(115, 255, 177); -unity-font-style: bold; }
.online-tab-viewport { flex-grow: 1; position: relative; overflow: hidden; }
.online-tab-page {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
}
.online-tab-enter-right { opacity: 0; translate: 60px 0; }
.online-tab-enter-left { opacity: 0; translate: -60px 0; }
.online-tab-exit-left { opacity: 0; translate: -60px 0; }
.online-tab-exit-right { opacity: 0; translate: 60px 0; }
.online-tab-scroll {
    flex-grow: 1;
    padding-left: 25px;
    padding-right: 25px;
    padding-top: 24px;
    padding-bottom: 28px;
}
.online-tab-scroll .unity-scroller--horizontal { display: none; }
.online-tab-scroll .unity-scroll-view__content-container { width: 100%; }
.tab-hero {
    min-height: 190px;
    margin-bottom: 28px;
    padding: 25px;
    justify-content: flex-end;
    overflow: hidden;
    background-color: rgb(4, 31, 22);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(76, 255, 153, 0.3);
    border-right-color: rgba(76, 255, 153, 0.3);
    border-top-color: rgba(76, 255, 153, 0.3);
    border-bottom-color: rgba(76, 255, 153, 0.3);
    border-top-left-radius: 24px;
    border-top-right-radius: 24px;
    border-bottom-left-radius: 24px;
    border-bottom-right-radius: 24px;
}
.store-hero { border-left-width: 5px; border-left-color: rgb(61, 235, 139); }
.shop-banner {
    position: relative;
    min-height: 132px;
    margin-bottom: 18px;
    padding: 22px;
    justify-content: center;
    overflow: hidden;
    background-color: rgb(13, 82, 51);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(83, 255, 156);
    border-right-color: rgb(83, 255, 156);
    border-top-color: rgb(83, 255, 156);
    border-bottom-color: rgb(83, 255, 156);
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 18px;
}
.shop-banner-title { font-size: 27px; letter-spacing: 4px; color: rgb(229, 255, 239); -unity-font-style: bold; }
.shop-banner-copy { margin-top: 7px; font-size: 10px; letter-spacing: 2px; color: rgba(200, 255, 225, 0.66); }
.shop-banner-emblem {
    position: absolute;
    right: 24px;
    top: 20px;
    width: 88px;
    height: 88px;
    align-items: center;
    justify-content: center;
    rotate: 7deg;
    background-color: rgba(0, 27, 18, 0.58);
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-color: rgb(247, 204, 75);
    border-right-color: rgb(247, 204, 75);
    border-top-color: rgb(247, 204, 75);
    border-bottom-color: rgb(247, 204, 75);
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 18px;
}
.shop-banner-emblem-text { font-size: 25px; color: rgb(255, 219, 94); -unity-font-style: bold; }
.featured-offer {
    position: relative;
    min-height: 500px;
    margin-bottom: 22px;
    overflow: hidden;
    background-color: rgb(29, 112, 62);
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-color: rgb(105, 255, 154);
    border-right-color: rgb(105, 255, 154);
    border-top-color: rgb(105, 255, 154);
    border-bottom-color: rgb(105, 255, 154);
    border-top-left-radius: 22px;
    border-top-right-radius: 22px;
    border-bottom-left-radius: 22px;
    border-bottom-right-radius: 22px;
}
.featured-offer-ribbon {
    height: 62px;
    align-items: center;
    justify-content: center;
    background-color: rgb(5, 52, 34);
    border-bottom-width: 2px;
    border-bottom-color: rgb(247, 203, 66);
}
.featured-offer-ribbon-text { font-size: 22px; letter-spacing: 4px; color: rgb(255, 221, 91); -unity-font-style: bold; }
