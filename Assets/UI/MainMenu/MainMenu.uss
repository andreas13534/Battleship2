    border-left-color: rgba(75, 255, 157, 0.42);
    border-right-color: rgba(75, 255, 157, 0.42);
    border-top-color: rgba(75, 255, 157, 0.42);
    border-bottom-color: rgba(75, 255, 157, 0.42);
