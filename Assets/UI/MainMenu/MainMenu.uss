.battle-card-radar { position: absolute; right: -35px; top: -44px; width: 330px; height: 330px; opacity: 0.55; background-color: rgba(18, 89, 55, 0.28); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgba(91, 255, 163, 0.32); border-right-color: rgba(91, 255, 163, 0.32); border-top-color: rgba(91, 255, 163, 0.32); border-bottom-color: rgba(91, 255, 163, 0.32); border-top-left-radius: 50%; border-top-right-radius: 50%; border-bottom-left-radius: 50%; border-bottom-right-radius: 50%; }
.battle-radar-ring { position: absolute; left: 20%; right: 20%; top: 20%; bottom: 20%; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgba(102, 255, 169, 0.32); border-right-color: rgba(102, 255, 169, 0.32); border-top-color: rgba(102, 255, 169, 0.32); border-bottom-color: rgba(102, 255, 169, 0.32); border-top-left-radius: 50%; border-top-right-radius: 50%; border-bottom-left-radius: 50%; border-bottom-right-radius: 50%; }
.battle-radar-ring-inner { left: 34%; right: 34%; top: 34%; bottom: 34%; }
.battle-radar-line { position: absolute; left: 50%; top: 8%; width: 2px; height: 42%; background-color: rgba(112, 255, 175, 0.54); rotate: 37deg; transform-origin: 50% 100%; }
