.commander-card-abilities { font-size: 18px; }

.ability-cinematic-abyss-torpedo .ability-cinematic-panel,
.ability-cinematic-abyss-submerge .ability-cinematic-panel {
    overflow: hidden;
    border-color: rgba(88, 227, 255, 0.55);
    background-color: rgba(0, 18, 28, 0.18);
}

.abyss-submerge-ship {
    position: absolute;
    left: 10%;
    right: 10%;
    top: 34%;
    height: 24%;
    opacity: 0.96;
    background-image: url("project://database/Assets/Art/NavalCommand/shot-animation/shot-enemy-close-destroyer.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(230, 239, 241);
    transition-property: -unity-background-image-tint-color, opacity;
    transition-duration: 0.09s;
}

.abyss-submerge-active .abyss-submerge-ship {
    opacity: 1;
    -unity-background-image-tint-color: rgb(34, 145, 255);
}

.abyss-torpedo {
    position: absolute;
    left: -34%;
    top: 53%;
    width: 34%;
    height: 13%;
    background-image: url("project://database/Assets/Art/NavalCommand/effects/abyss-torpedo-side.png");
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.1s, 1s;
    transition-timing-function: linear;
}

.abyss-torpedo-armed .abyss-torpedo { opacity: 1; }
.abyss-torpedo-running .abyss-torpedo { opacity: 1; translate: 920px 0; }
.abyss-torpedo-impact .abyss-torpedo { opacity: 0; }

.abyss-row-impact {
    position: absolute;
    top: 39%;
    width: 16%;
    height: 24%;
    background-image: url("project://database/Assets/Art/NavalCommand/shot-animation/shot-water-splash.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(136, 235, 255);
    opacity: 0;
    scale: 0.25 0.25;
    transition-property: opacity, scale, translate;
    transition-duration: 0.24s, 0.4s, 0.52s;
}

.abyss-impact-hit {
    background-image: url("project://database/Assets/Art/NavalCommand/shot-animation/shot-hit-explosion.png");
    -unity-background-image-tint-color: rgb(255, 188, 96);
}

.abyss-impact-splash {
    background-image: url("project://database/Assets/Art/NavalCommand/shot-animation/shot-water-splash.png");
    -unity-background-image-tint-color: rgb(136, 235, 255);
}

.abyss-row-impact-0 { left: -3%; }
.abyss-row-impact-1 { left: 7%; transition-delay: 0.12s; }
.abyss-row-impact-2 { left: 17%; transition-delay: 0.24s; }
.abyss-row-impact-3 { left: 27%; transition-delay: 0.36s; }
.abyss-row-impact-4 { left: 37%; transition-delay: 0.48s; }
.abyss-row-impact-5 { left: 47%; transition-delay: 0.6s; }
.abyss-row-impact-6 { left: 57%; transition-delay: 0.72s; }
.abyss-row-impact-7 { left: 67%; transition-delay: 0.84s; }
.abyss-row-impact-8 { left: 77%; transition-delay: 0.96s; }
.abyss-row-impact-9 { left: 87%; transition-delay: 1.08s; }
.abyss-torpedo-impact .abyss-row-impact { opacity: 0.92; scale: 1 1; translate: 0 -26px; }

.ability-cinematic-abyss-torpedo .ability-cinematic-result,
.ability-cinematic-abyss-submerge .ability-cinematic-result {
    top: 79%;
}
.startup-splash {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgb(0, 0, 0);
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.34s;
    transition-timing-function: ease-out;
}

.startup-splash-logo {
    width: 72%;
    height: 64%;
    background-image: url("project://database/Assets/Art/NavalCommand/Splash/battleship-2-splash-logo.png");
    -unity-background-scale-mode: scale-to-fit;
    background-repeat: no-repeat;
    opacity: 0;
    scale: 0.86 0.86;
    transition-property: opacity, scale;
    transition-duration: 0.22s;
    transition-timing-function: ease-out;
}

.startup-splash-logo-visible {
    opacity: 1;
    scale: 1 1;
}

.startup-splash-out {
    opacity: 0;
}
