.app-root {
    flex-grow: 1;
    background-color: rgb(1, 7, 5);
    color: rgb(111, 255, 166);
}

/* Keep TITAN result treatment after the shared cinematic rules. */
.commander-ability-cinematic.ability-cinematic-titan-nuclear .ability-cinematic-result {
    background-color: rgba(28, 9, 2, 0.9);
    border-left-color: rgba(255, 177, 61, 0.8);
    border-right-color: rgba(255, 177, 61, 0.8);
    border-top-color: rgba(255, 177, 61, 0.8);
    border-bottom-color: rgba(255, 177, 61, 0.8);
    color: rgb(255, 214, 111);
}

.screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(1, 7, 5);
    color: rgb(111, 255, 166);
    padding-left: 7%;
    padding-right: 7%;
    padding-top: 4%;
    padding-bottom: 4%;
    overflow: hidden;
}

.hidden { display: none; }

/* First-launch Ausbildung // Clash-like guided actions in Naval Command's own visual language */
.tutorial-menu-button {
    height: 38px;
    margin-top: 8px;
    font-size: 12px;
    letter-spacing: 2px;
}

.tutorial-replay-button {
    position: absolute;
    right: 4%;
    bottom: 4%;
    height: 38px;
    background-color: rgba(4, 18, 23, 0.88);
    color: rgba(210, 232, 239, 0.78);
    border-left-color: rgba(255, 205, 84, 0.55);
    border-right-color: rgba(255, 205, 84, 0.55);
    border-top-color: rgba(255, 205, 84, 0.55);
    border-bottom-color: rgba(255, 205, 84, 0.55);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    font-size: 11px;
    letter-spacing: 2px;
}

.tutorial-skip-button {
    position: absolute;
    top: 20px;
    right: 24px;
    height: 48px;
    min-width: 200px;
    padding-left: 20px;
    padding-right: 20px;
    font-size: 20px;
    background-color: rgb(17, 31, 38);
    color: rgb(239, 245, 242);
}

.tutorial-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.tutorial-scrim {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 5, 9, 0.76);
}

.tutorial-callout {
    position: absolute;
    left: 2%;
    bottom: 0;
    width: 760px;
    height: 400px;
    background-color: rgba(0, 0, 0, 0);
}

.tutorial-callout-modal {
    left: 5%;
    bottom: 2%;
}

.tutorial-callout-right {
    left: auto;
    right: 2%;
}
.tutorial-callout-right .tutorial-portrait {
    left: auto;
    right: 0;
}
.tutorial-callout-right .tutorial-copy {
    left: 20px;
}
.tutorial-callout-right .tutorial-bubble-tail {
    left: auto;
    right: -16px;
    border-left-width: 0;
    border-bottom-width: 0;
    border-right-color: rgb(216, 224, 228);
    border-top-color: rgb(216, 224, 228);
    border-right-width: 2px;
    border-top-width: 2px;
}

.tutorial-portrait {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 330px;
    height: 365px;
    background-image: url("project://database/Assets/Art/NavalCommand/tutorial/instructor-konrad-weiss-transparent.png");
    -unity-background-scale-mode: scale-to-fit;
}

.tutorial-copy {
    position: absolute;
    left: 255px;
    top: 20px;
    width: 475px;
    min-height: 178px;
    justify-content: center;
    padding: 24px;
    background-color: rgb(248, 250, 251);
    border-radius: 24px;
    border-left-color: rgb(216, 224, 228);
    border-right-color: rgb(216, 224, 228);
    border-top-color: rgb(216, 224, 228);
    border-bottom-color: rgb(216, 224, 228);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
}
.tutorial-bubble-tail {
    position: absolute;
    left: -16px;
    bottom: 34px;
    width: 34px;
    height: 34px;
    rotate: 45deg;
    background-color: rgb(248, 250, 251);
    border-left-color: rgb(216, 224, 228);
    border-bottom-color: rgb(216, 224, 228);
    border-left-width: 2px;
    border-bottom-width: 2px;
}
.tutorial-eyebrow, .tutorial-title, .tutorial-task { display: none; }
.tutorial-body {
    color: rgb(24, 39, 46);
    font-size: 34px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}
.tutorial-continue {
    height: 52px;
    margin-top: 14px;
    font-size: 18px;
    background-color: rgb(20, 126, 70);
    color: white;
    border-left-color: rgb(12, 82, 45);
    border-right-color: rgb(12, 82, 45);
    border-top-color: rgb(12, 82, 45);
    border-bottom-color: rgb(12, 82, 45);
}

.tutorial-highlight {
    border-left-color: rgb(255, 210, 76);
    border-right-color: rgb(255, 210, 76);
    border-top-color: rgb(255, 210, 76);
    border-bottom-color: rgb(255, 210, 76);
    border-left-width: 4px;
    border-right-width: 4px;
    border-top-width: 4px;
    border-bottom-width: 4px;
}


.grid-decoration {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    opacity: 0.2;
}

.grid-line { position: absolute; background-color: rgb(19, 95, 55); }
.grid-v { top: 0; bottom: 0; width: 1px; }
.grid-h { left: 0; right: 0; height: 1px; }
.v1 { left: 8%; } .v2 { left: 29%; } .v3 { left: 50%; } .v4 { left: 71%; }
.h1 { top: 10%; } .h2 { top: 25%; } .h3 { top: 40%; } .h4 { top: 65%; } .h5 { top: 88%; }

.radar {
    position: absolute;
    border-color: rgba(31, 235, 116, 0.25);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-radius: 50%;
}
.radar-menu { width: 620px; height: 620px; right: -220px; top: 19%; }
.radar-inner { width: 360px; height: 360px; left: 128px; top: 128px; }
.radar-cross { position: absolute; background-color: rgba(31, 235, 116, 0.16); }
.radar-cross-h { height: 1px; left: 0; right: 0; top: 307px; }
.radar-cross-v { width: 1px; top: 0; bottom: 0; left: 307px; }

.topbar, .compact-header, .battle-header {
    height: 112px;
    flex-direction: row;
    align-items: center;
    border-bottom-color: rgba(60, 255, 135, 0.48);
    border-bottom-width: 1px;
}

.topbar { justify-content: space-between; }
.status {
    font-size: 20px;
    letter-spacing: 4px;
    color: rgba(117, 255, 169, 0.8);
    -unity-font-style: bold;
}

.signal {
    width: 58px;
    height: 30px;
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
}
.signal-bar { width: 11px; background-color: rgb(66, 255, 137); }
.s1 { height: 9px; opacity: 0.45; } .s2 { height: 18px; opacity: 0.7; } .s3 { height: 28px; }

.menu-content { flex-grow: 1; justify-content: center; }
.title-block { margin-bottom: 145px; align-items: flex-start; }
.title {
    color: rgb(99, 255, 156);
    -unity-font-style: bold;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(51, 255, 127, 0.28);
}
.title-small { font-size: 58px; letter-spacing: 20px; margin-bottom: -14px; }
.title-large { font-size: 106px; letter-spacing: 7px; }
.title-rule { margin-top: 22px; width: 74%; height: 3px; background-color: rgba(64, 255, 135, 0.25); }
.rule-hot { width: 28%; height: 3px; background-color: rgb(61, 255, 133); }

.action-frame { height: 142px; padding: 18px; justify-content: center; }
.primary-button, .secondary-button, .icon-button {
    border-radius: 0;
    -unity-font-style: bold;
}
.primary-button {
    background-color: rgba(7, 29, 18, 0.96);
    color: rgb(120, 255, 170);
    border-left-color: rgb(63, 255, 137);
    border-right-color: rgb(63, 255, 137);
    border-top-color: rgb(63, 255, 137);
    border-bottom-color: rgb(63, 255, 137);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    letter-spacing: 6px;
}
.primary-button:hover { background-color: rgb(26, 255, 111); color: rgb(0, 17, 8); }
.primary-button:active { background-color: rgb(173, 255, 198); color: rgb(0, 17, 8); }
.start-button { flex-grow: 1; font-size: 31px; }

.debug-toggle {
    width: 72%;
    height: 58px;
    margin-top: 22px;
    align-self: center;
    color: rgba(117, 255, 169, 0.72);
    font-size: 16px;
    letter-spacing: 2px;
    -unity-font-style: bold;
}
.debug-toggle .unity-toggle__input {
    width: 48px;
    height: 32px;
    margin-right: 16px;
    background-color: rgba(4, 22, 13, 0.96);
    border-left-color: rgba(63, 255, 137, 0.55);
    border-right-color: rgba(63, 255, 137, 0.55);
    border-top-color: rgba(63, 255, 137, 0.55);
    border-bottom-color: rgba(63, 255, 137, 0.55);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
}
.debug-toggle:checked {
    color: rgb(255, 210, 82);
}
.debug-toggle:checked .unity-toggle__input {
    background-color: rgba(255, 190, 42, 0.24);
    border-left-color: rgb(255, 210, 82);
    border-right-color: rgb(255, 210, 82);
    border-top-color: rgb(255, 210, 82);
    border-bottom-color: rgb(255, 210, 82);
}

.secondary-button {
    background-color: rgba(4, 20, 12, 0.9);
    color: rgba(120, 255, 170, 0.78);
    border-left-color: rgba(63, 255, 137, 0.5);
    border-right-color: rgba(63, 255, 137, 0.5);
    border-top-color: rgba(63, 255, 137, 0.5);
    border-bottom-color: rgba(63, 255, 137, 0.5);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    letter-spacing: 3px;
}

.icon-button {
    width: 76px;
    height: 76px;
    margin-right: 22px;
    background-color: rgba(6, 25, 15, 0.95);
    color: rgb(97, 255, 156);
    border-left-color: rgb(63, 255, 137);
    border-right-color: rgb(63, 255, 137);
    border-top-color: rgb(63, 255, 137);
    border-bottom-color: rgb(63, 255, 137);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    font-size: 48px;
}

.corner { position: absolute; width: 28px; height: 28px; }
.corner-tl { left: 0; top: 0; border-left-color: rgb(99,255,156); border-left-width: 3px; border-top-color: rgb(99,255,156); border-top-width: 3px; }
.corner-tr { right: 0; top: 0; border-right-color: rgb(99,255,156); border-right-width: 3px; border-top-color: rgb(99,255,156); border-top-width: 3px; }
.corner-bl { left: 0; bottom: 0; border-left-color: rgb(99,255,156); border-left-width: 3px; border-bottom-color: rgb(99,255,156); border-bottom-width: 3px; }
.corner-br { right: 0; bottom: 0; border-right-color: rgb(99,255,156); border-right-width: 3px; border-bottom-color: rgb(99,255,156); border-bottom-width: 3px; }

.bottombar { height: 86px; justify-content: flex-end; }
.bottom-line { height: 1px; align-self: stretch; background-color: rgba(60,255,135,0.42); margin-bottom: 18px; }
.footer-status { font-size: 15px; letter-spacing: 3px; color: rgba(111,255,166,0.55); }

.header-copy { flex-grow: 1; }
.screen-title { font-size: 31px; letter-spacing: 5px; -unity-font-style: bold; color: rgb(105,255,161); }
.micro-label { font-size: 15px; letter-spacing: 2px; color: rgba(111,255,166,0.58); }

.setup-main { flex-grow: 1; }
.board-frame {
    position: relative;
    background-color: rgba(2, 13, 8, 0.96);
    border-left-color: rgba(61,255,133,0.24);
    border-right-color: rgba(61,255,133,0.24);
    border-top-color: rgba(61,255,133,0.24);
    border-bottom-color: rgba(61,255,133,0.24);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    padding: 28px;
}
.setup-board-frame { height: 895px; margin-top: 28px; margin-bottom: 28px; }
.board-caption { height: 44px; font-size: 17px; letter-spacing: 3px; color: rgba(110,255,165,0.62); }

.battle-grid {
    position: relative;
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    background-color: rgb(1, 12, 8);
    border-left-color: rgba(63,255,137,0.8);
    border-right-color: rgba(63,255,137,0.8);
    border-top-color: rgba(63,255,137,0.8);
    border-bottom-color: rgba(63,255,137,0.8);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    overflow: hidden;
}
.setup-grid { flex-grow: 1; }

.grid-cell {
    width: 10%;
    height: 10%;
    min-width: 0;
    min-height: 0;
    flex-grow: 0;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    background-color: rgba(3, 20, 12, 0.68);
    border-left-color: rgba(56, 179, 102, 0.32);
    border-right-color: rgba(56, 179, 102, 0.32);
    border-top-color: rgba(56, 179, 102, 0.32);
    border-bottom-color: rgba(56, 179, 102, 0.32);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-radius: 0;
    color: rgb(102, 255, 158);
    font-size: 42px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.grid-cell:hover { background-color: rgba(14, 63, 36, 0.88); }
.cell-preview-valid { background-color: rgba(42, 255, 120, 0.34); }
.cell-preview-invalid { background-color: rgba(255, 48, 65, 0.35); }
.cell-ship { background-color: rgba(45, 126, 78, 0.48); }
.cell-hit {
    color: rgb(255, 64, 86);
    font-size: 31px;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgba(255, 25, 52, 0.35);
}
.cell-miss {
    color: rgb(67, 255, 139);
    font-size: 27px;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(31, 255, 112, 0.28);
}
.cell-sunk {
    opacity: 1;
    color: rgb(255, 105, 80);
    font-size: 34px;
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: rgb(255, 42, 35);
}

.ship-console, .command-console {
    background-color: rgba(2, 15, 9, 0.98);
    border-left-color: rgba(61,255,133,0.5);
    border-right-color: rgba(61,255,133,0.5);
    border-top-color: rgba(61,255,133,0.5);
    border-bottom-color: rgba(61,255,133,0.5);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    padding: 24px;
}
.ship-console { flex-grow: 1; min-height: 560px; }
.console-header { height: 50px; flex-direction: row; justify-content: space-between; align-items: center; }
.console-title { font-size: 19px; letter-spacing: 4px; -unity-font-style: bold; color: rgb(99,255,156); }

.ship-tray {
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: wrap;
    align-content: center;
    justify-content: space-between;
    padding-top: 12px;
    padding-bottom: 12px;
}
.ship-card {
    position: relative;
    width: 48%;
    height: 102px;
    margin-top: 6px;
    margin-bottom: 6px;
    background-color: rgba(5, 25, 15, 0.9);
    border-left-color: rgba(65,255,138,0.35);
    border-right-color: rgba(65,255,138,0.35);
    border-top-color: rgba(65,255,138,0.35);
    border-bottom-color: rgba(65,255,138,0.35);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    justify-content: center;
    align-items: center;
}
.ship-card-wide { width: 100%; }
.ship-card-selected { border-left-color: rgb(72,255,143); border-right-color: rgb(72,255,143); border-top-color: rgb(72,255,143); border-bottom-color: rgb(72,255,143); background-color: rgba(15,70,39,0.8); }
.ship-card-placed { opacity: 0.24; }
.ship-image {
    width: 88%;
    height: 76%;
    -unity-background-scale-mode: scale-to-fit;
    background-repeat: no-repeat;
}
.ship-board {
    position: absolute;
    opacity: 0.9;
    -unity-background-scale-mode: scale-to-fit;
    background-repeat: no-repeat;
}
.ship-board-sunk {
    opacity: 1;
    -unity-background-image-tint-color: rgb(165, 172, 174);
}
.ship-board-vertical { rotate: 90deg; }

.ship-2 { background-image: url("project://database/Assets/Art/NavalCommand/individual-ships/grid-ready-128/01-patrol-interceptor-2x1.png"); }
.ship-3a { background-image: url("project://database/Assets/Art/NavalCommand/individual-ships/grid-ready-128/03-fast-destroyer-3x1.png"); }
.ship-3b { background-image: url("project://database/Assets/Art/NavalCommand/individual-ships/grid-ready-128/04-attack-submarine-3x1.png"); }

.cell-submerged {
    background-color: rgba(12, 101, 128, 0.76);
    border-color: #53e6ff;
    color: #b9f7ff;
}

.cell-shot-blocked {
    background-color: rgba(10, 65, 89, 0.92);
    border-color: #62dcff;
    color: #d4fbff;
}
.ship-4 { background-image: url("project://database/Assets/Art/NavalCommand/individual-ships/grid-ready-128/06-heavy-missile-cruiser-4x1.png"); }
.ship-5 { background-image: url("project://database/Assets/Art/NavalCommand/individual-ships/grid-ready-128/09-aircraft-carrier-5x1.png"); }
.ship-14 { background-image: url("project://database/Assets/Art/NavalCommand/individual-ships/grid-ready-128/13-floating-fortress-7x2.png"); }
.ship-6 { background-image: url("project://database/Assets/Art/NavalCommand/individual-ships/grid-ready-128/12-fork-ship-3x2.png"); }

.setup-actions { height: 104px; flex-direction: row; }
.setup-actions .secondary-button { width: 30%; margin-right: 16px; font-size: 19px; }
.battle-start-button { flex-grow: 1; font-size: 21px; }
.battle-start-button:disabled { opacity: 0.3; }

.battle-header { justify-content: space-between; }
.points-panel { width: 130px; height: 80px; align-items: center; justify-content: center; border-left-color: rgba(61,255,133,0.45); border-right-color: rgba(61,255,133,0.45); border-top-color: rgba(61,255,133,0.45); border-bottom-color: rgba(61,255,133,0.45); border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; }
.points-value { font-size: 33px; -unity-font-style: bold; color: rgb(105,255,161); }
.sunk-enemy-ships {
    position: absolute;
    left: -10px;
    top: 82px;
    width: 150px;
    min-height: 28px;
    padding: 4px;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    background-color: rgba(5, 18, 23, 0.72);
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}
.sunk-ship-marker {
    height: 17px;
    margin-left: 2px;
    margin-right: 2px;
    opacity: 0.78;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(71, 94, 101);
}
.turn-panel { height: 80px; min-width: 430px; flex-direction: row; align-items: center; justify-content: center; background-color: rgba(4,22,13,0.9); border-left-color: rgba(61,255,133,0.5); border-right-color: rgba(61,255,133,0.5); border-top-color: rgba(61,255,133,0.5); border-bottom-color: rgba(61,255,133,0.5); border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; }
.turn-dot { width: 22px; height: 22px; border-radius: 50%; margin-right: 18px; }
.turn-player { background-color: rgb(45,255,122); }
.turn-enemy { background-color: rgb(255,42,64); }
.turn-label { font-size: 22px; letter-spacing: 3px; -unity-font-style: bold; }

.battle-main { flex-grow: 1; padding-top: 26px; }
.main-board-frame { width: 850px; height: 900px; align-self: center; }
.main-battle-grid { flex-grow: 1; }
.battle-message { height: 62px; margin-top: 14px; font-size: 24px; letter-spacing: 3px; -unity-text-align: middle-center; color: rgba(111,255,166,0.8); }

.command-console { height: 650px; }
.command-header { border-bottom-color: rgba(61,255,133,0.25); border-bottom-width: 1px; }
.command-panels { flex-grow: 1; flex-direction: row; padding-top: 18px; }
.fleet-panel { width: 43%; margin-right: 20px; }
.mini-panel { flex-grow: 1; }
.panel-label { height: 42px; font-size: 20px; letter-spacing: 2px; color: rgba(111,255,166,0.78); -unity-font-style: bold; }
.fleet-status { flex-grow: 1; justify-content: space-around; }
.fleet-row { height: 65px; flex-direction: row; align-items: center; padding-left: 8px; padding-right: 8px; background-color: rgba(4,22,13,0.75); border-bottom-color: rgba(61,255,133,0.2); border-bottom-width: 1px; }
.fleet-row-sunk { opacity: 0.32; background-color: rgba(80,15,22,0.65); }
.fleet-icon { width: 54%; height: 52px; -unity-background-scale-mode: scale-to-fit; background-repeat: no-repeat; }
.fleet-health { flex-grow: 1; flex-direction: row; justify-content: flex-end; }
.health-pip { width: 9px; height: 24px; margin-left: 4px; background-color: rgb(64,255,136); }
.health-pip-lost { background-color: rgba(255,48,66,0.5); }
.mini-grid { width: 100%; flex-grow: 1; }
.mini-grid .grid-cell { font-size: 15px; border-left-width: 0; border-right-width: 1px; border-top-width: 0; border-bottom-width: 1px; }


/* Commander selection */
.commander-list {
    flex-grow: 1;
    min-height: 0;
    padding-top: 28px;
    padding-bottom: 18px;
    padding-left: 4px;
    padding-right: 4px;
}
.commander-list > .unity-scroll-view__content-viewport {
    flex-grow: 1;
}
.commander-list .unity-scroll-view__content-container {
    width: 100%;
}
.commander-card {
    min-height: 230px;
    flex-shrink: 0;
    margin-top: 10px;
    margin-bottom: 10px;
    padding: 18px;
    flex-direction: row;
    background-color: rgba(3, 18, 11, 0.96);
    border-left-color: rgba(65, 255, 138, 0.38);
    border-right-color: rgba(65, 255, 138, 0.38);
    border-top-color: rgba(65, 255, 138, 0.38);
    border-bottom-color: rgba(65, 255, 138, 0.38);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
}
.commander-portrait {
    width: 250px;
    height: 194px;
    margin-right: 24px;
    background-color: rgb(5, 24, 15);
    -unity-background-scale-mode: scale-and-crop;
    border-left-color: rgba(74, 255, 145, 0.55);
    border-right-color: rgba(74, 255, 145, 0.55);
    border-top-color: rgba(74, 255, 145, 0.55);
    border-bottom-color: rgba(74, 255, 145, 0.55);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    align-items: center;
    justify-content: center;
}
.portrait-standard {
    background-color: rgb(4, 25, 14);
}
.portrait-elias {
    background-image: url("project://database/Assets/Art/NavalCommand/captain-portraits/01-male-veteran-commander.png");
}
.portrait-dae {
    background-image: url("project://database/Assets/Art/NavalCommand/captain-portraits/02-male-tactical-analyst.png");
}
.portrait-ronan {
    background-image: url("project://database/Assets/Art/NavalCommand/captain-portraits/03-male-red-bearded-corsair.png");
}
.portrait-arjan {
    background-image: url("project://database/Assets/Art/NavalCommand/captain-portraits/04-male-sikh-strategist.png");
}
.portrait-mateo {
    background-image: url("project://database/Assets/Art/NavalCommand/captain-portraits/05-male-daring-navigator.png");
}
.portrait-imani {
    background-image: url("project://database/Assets/Art/NavalCommand/captain-portraits/09-female-braided-commander.png");
}

.raptor-jet-board {
    opacity: 1;
    background-image: url("project://database/Assets/Art/NavalCommand/effects/raptor-jet-top.png");
    -unity-background-scale-mode: scale-to-fit;
}

/* Ronan Graves // TITAN water cinematics */
.ability-cinematic-titan-relocation .ability-ocean-grade,
.ability-cinematic-titan-nuclear .ability-ocean-grade {
    background-color: rgba(0, 12, 20, 0.18);
}
.titan-relocation-ship {
    position: absolute;
    left: 7%;
    top: 55.1%;
    width: 86%;
    height: 25%;
    opacity: 1;
    background-image: url("project://database/Assets/Art/NavalCommand/shot-animation/shot-enemy-close-destroyer.png");
    -unity-background-scale-mode: scale-to-fit;
    transition-property: opacity;
    transition-duration: 0.1s;
}
.titan-relocation-vanish .titan-relocation-ship { opacity: 0; }
.titan-relocation-complete .titan-relocation-ship {
    left: 19%;
    top: 32.3%;
    width: 62%;
    height: 18%;
}
.titan-relocation-vanish .titan-teleport-ring { opacity: 1; scale: 1.15 1.15; }
.titan-relocation-complete .titan-teleport-ring { top: 39%; width: 62%; left: 19%; }
.titan-teleport-ring {
    position: absolute;
    left: 7%;
    top: 63%;
    width: 86%;
    height: 10%;
    opacity: 0;
    border-left-width: 5px;
    border-right-width: 5px;
    border-top-width: 5px;
    border-bottom-width: 5px;
    border-left-color: rgba(81, 255, 184, 0.86);
    border-right-color: rgba(81, 255, 184, 0.86);
    border-top-color: rgba(81, 255, 184, 0.86);
    border-bottom-color: rgba(81, 255, 184, 0.86);
    border-radius: 50%;
    transition-property: opacity, scale;
    transition-duration: 0.18s;
}
.titan-target-ship {
    position: absolute;
    left: 7%;
    right: 7%;
    top: 39%;
    height: 25%;
    background-image: url("project://database/Assets/Art/NavalCommand/shot-animation/shot-enemy-frigate.png");
    -unity-background-scale-mode: scale-to-fit;
}
.titan-nuclear-missile {
    position: absolute;
    left: 50%;
    top: -15%;
    width: 52px;
    height: 178px;
    margin-left: -26px;
    rotate: 180deg;
    opacity: 0;
    transition-property: opacity, top;
    transition-duration: 0.86s;
    transition-timing-function: ease-in;
}
.titan-nuclear-missile-sprite {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("project://database/Assets/Art/NavalCommand/shot-animation/shot-missile.png");
    -unity-background-scale-mode: scale-to-fit;
}
.titan-nuclear-trail {
    position: absolute;
    left: 21px;
    top: 142px;
    width: 10px;
    height: 260px;
    background-color: rgba(255, 119, 28, 0.5);
    border-left-width: 2px;
    border-right-width: 2px;
    border-left-color: rgba(255, 235, 151, 0.74);
    border-right-color: rgba(255, 56, 18, 0.62);
}
.titan-nuclear-flame {
    position: absolute;
    left: 15px;
    top: 140px;
    width: 22px;
    height: 60px;
    background-color: rgb(255, 170, 44);
    border-radius: 50%;
}
.titan-nuclear-particle {
    position: absolute;
    top: 155px;
    width: 11px;
    height: 20px;
    opacity: 0;
    background-color: rgb(255, 175, 44);
    border-radius: 50%;
    transition-property: opacity, translate, scale;
    transition-duration: 0.48s;
}
.titan-nuclear-particle-0 { left: 7px; }
.titan-nuclear-particle-1 { left: 18px; transition-duration: 0.34s; }
.titan-nuclear-particle-2 { left: 30px; transition-duration: 0.58s; }
.titan-nuclear-particle-3 { left: 12px; top: 169px; transition-duration: 0.41s; }
.titan-nuclear-particle-4 { left: 27px; top: 165px; transition-duration: 0.66s; }
.titan-nuclear-incoming .titan-nuclear-particle { opacity: 0.94; translate: -17px 112px; scale: 0.3 0.3; }
.titan-nuclear-incoming .titan-nuclear-particle-1 { translate: 12px 148px; }
.titan-nuclear-incoming .titan-nuclear-particle-2 { translate: 24px 97px; }
.titan-nuclear-incoming .titan-nuclear-particle-3 { translate: -8px 172px; }
.titan-nuclear-incoming .titan-nuclear-particle-4 { translate: 18px 132px; }
.titan-nuclear-incoming .titan-nuclear-missile {
    opacity: 1;
    top: 43%;
}
.titan-nuclear-will-miss.titan-nuclear-incoming .titan-nuclear-missile {
    left: 53.6%;
    top: 66%;
}
.titan-nuclear-hit .titan-nuclear-missile,
.titan-nuclear-miss .titan-nuclear-missile { opacity: 0; transition-duration: 0.04s; }
.titan-nuclear-impact {
    position: absolute;
    left: 50%;
    top: 52%;
    width: 1px;
    height: 1px;
}
.titan-nuclear-will-miss .titan-nuclear-impact {
    left: 53.6%;
    top: 75%;
}
.titan-nuclear-splash {
    position: absolute;
    left: -150px;
    top: -290px;
    width: 300px;
    height: 320px;
    opacity: 0;
    scale: 0.15 0.15;
    background-image: url("project://database/Assets/Art/NavalCommand/shot-animation/shot-water-splash.png");
    -unity-background-scale-mode: scale-to-fit;
    transition-property: opacity, scale, translate;
    transition-duration: 0.28s;
}
.titan-nuclear-miss .titan-nuclear-splash { opacity: 1; scale: 1 1; translate: 0 -16px; }
.titan-nuclear-flash {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    opacity: 0;
    background-color: rgba(255, 244, 200, 0.96);
    transition-property: opacity;
    transition-duration: 0.14s;
}
.titan-nuclear-hit .titan-nuclear-flash { opacity: 1; }
.titan-nuclear-aftermath .titan-nuclear-flash { opacity: 0; transition-duration: 0.35s; }
.titan-nuclear-mushroom {
    position: absolute;
    left: 11%;
    top: -20%;
    width: 78%;
    height: 72%;
    opacity: 0;
    scale: 0.08 0.08;
    background-image: url("project://database/Assets/Art/NavalCommand/effects/titan-nuclear-mushroom.png");
    -unity-background-scale-mode: scale-to-fit;
    transition-property: opacity, scale;
    transition-duration: 0.72s;
    transition-timing-function: ease-out;
}
.titan-nuclear-hit .titan-nuclear-mushroom { opacity: 1; scale: 1 1; }
.titan-nuclear-hit .titan-target-ship { opacity: 0; }

.titan-nuclear-firestorm {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    overflow: hidden;
}
.titan-fire-ember {
    position: absolute;
    top: 88%;
    width: 10px;
    height: 22px;
    opacity: 0;
    scale: 0.35 0.35;
    background-color: rgb(255, 125, 27);
    border-radius: 50%;
    border-left-width: 2px;
    border-right-width: 2px;
    border-left-color: rgb(255, 232, 127);
    border-right-color: rgb(178, 38, 7);
    transition-property: opacity, translate, scale;
    transition-duration: 1.55s;
    transition-timing-function: ease-out;
}
.titan-nuclear-hit .titan-fire-ember { opacity: 0.92; translate: 0 -920px; scale: 1 1; }
.titan-fire-ember-0 { left: 3%; top: 94%; transition-duration: 1.15s; }
.titan-fire-ember-1 { left: 9%; top: 77%; transition-duration: 1.7s; }
.titan-fire-ember-2 { left: 15%; top: 91%; transition-duration: 1.3s; }
.titan-fire-ember-3 { left: 21%; top: 72%; transition-duration: 1.85s; }
.titan-fire-ember-4 { left: 27%; top: 98%; transition-duration: 1.45s; }
.titan-fire-ember-5 { left: 34%; top: 82%; transition-duration: 1.05s; }
.titan-fire-ember-6 { left: 40%; top: 93%; transition-duration: 1.65s; }
.titan-fire-ember-7 { left: 46%; top: 76%; transition-duration: 1.25s; }
.titan-fire-ember-8 { left: 52%; top: 97%; transition-duration: 1.9s; }
.titan-fire-ember-9 { left: 58%; top: 84%; transition-duration: 1.4s; }
.titan-fire-ember-10 { left: 64%; top: 92%; transition-duration: 1.1s; }
.titan-fire-ember-11 { left: 70%; top: 73%; transition-duration: 1.75s; }
.titan-fire-ember-12 { left: 76%; top: 96%; transition-duration: 1.35s; }
.titan-fire-ember-13 { left: 82%; top: 80%; transition-duration: 1.95s; }
.titan-fire-ember-14 { left: 88%; top: 90%; transition-duration: 1.5s; }
.titan-fire-ember-15 { left: 94%; top: 75%; transition-duration: 1.2s; }
.titan-fire-ember-16 { left: 31%; top: 68%; transition-duration: 1.8s; }
.titan-fire-ember-17 { left: 67%; top: 66%; transition-duration: 1.6s; }
.titan-nuclear-hit .titan-fire-ember-0,
.titan-nuclear-hit .titan-fire-ember-4,
.titan-nuclear-hit .titan-fire-ember-8,
.titan-nuclear-hit .titan-fire-ember-12 { translate: -95px -980px; }
.titan-nuclear-hit .titan-fire-ember-2,
.titan-nuclear-hit .titan-fire-ember-6,
.titan-nuclear-hit .titan-fire-ember-10,
.titan-nuclear-hit .titan-fire-ember-14 { translate: 105px -860px; }
.ability-cinematic-titan-nuclear .ability-cinematic-result {
    background-color: rgba(28, 9, 2, 0.9);
    border-left-color: rgba(255, 177, 61, 0.8);
    border-right-color: rgba(255, 177, 61, 0.8);
    border-top-color: rgba(255, 177, 61, 0.8);
    border-bottom-color: rgba(255, 177, 61, 0.8);
    color: rgb(255, 214, 111);
}
.portrait-monogram {
    font-size: 86px;
    letter-spacing: 8px;
    -unity-font-style: bold;
    color: rgba(81, 255, 148, 0.8);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgba(32, 255, 120, 0.25);
}
.commander-card-copy {
    flex-grow: 1;
    justify-content: center;
}
.commander-card-heading {
    min-height: 50px;
    flex-direction: row;
    align-items: center;
}
.commander-card-name {
    flex-grow: 1;
    font-size: 27px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    color: rgb(105, 255, 161);
    white-space: normal;
}
.commander-info-button {
    width: 46px;
    height: 46px;
    min-width: 46px;
    margin-left: 14px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 2px;
    align-items: center;
    justify-content: center;
    font-size: 25px;
    -unity-font-style: bold;
    color: rgb(247, 210, 74);
    background-color: rgb(4, 37, 24);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(247, 210, 74);
    border-right-color: rgb(247, 210, 74);
    border-top-color: rgb(247, 210, 74);
    border-bottom-color: rgb(247, 210, 74);
    border-top-left-radius: 23px;
    border-top-right-radius: 23px;
    border-bottom-left-radius: 23px;
    border-bottom-right-radius: 23px;
}
.commander-info-button.info-open {
    color: rgb(3, 28, 17);
    background-color: rgb(247, 210, 74);
}
.commander-card-info {
    margin-top: 14px;
    padding-top: 13px;
    padding-bottom: 4px;
    border-top-width: 1px;
    border-top-color: rgba(84, 255, 151, 0.26);
}
.commander-card-rank {
    font-size: 15px;
    letter-spacing: 2px;
    color: rgba(111, 255, 166, 0.62);
    margin-bottom: 14px;
}
.commander-card-abilities {
    font-size: 17px;
    letter-spacing: 1px;
    color: rgb(101, 226, 151);
    margin-bottom: 12px;
}
.commander-select-button {
    height: 64px;
    margin-top: 16px;
    font-size: 18px;
}

/* Commander controls in command center */
.ability-deck {
    height: 118px;
    flex-direction: row;
    align-items: center;
    padding-top: 12px;
    padding-bottom: 12px;
    border-bottom-color: rgba(61, 255, 133, 0.25);
    border-bottom-width: 1px;
}
.battle-commander-portrait {
    width: 86px;
    height: 86px;
    margin-right: 14px;
    -unity-background-scale-mode: scale-and-crop;
    border-left-color: rgba(75, 255, 145, 0.58);
    border-right-color: rgba(75, 255, 145, 0.58);
    border-top-color: rgba(75, 255, 145, 0.58);
    border-bottom-color: rgba(75, 255, 145, 0.58);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    align-items: center;
    justify-content: center;
}
.battle-portrait-monogram {
    font-size: 24px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    color: rgb(91, 255, 151);
}
.battle-commander-copy {
    width: 300px;
    justify-content: center;
}
.battle-commander-name {
    font-size: 16px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    color: rgb(104, 255, 160);
}
.battle-commander-rank {
    margin-top: 5px;
    font-size: 11px;
    letter-spacing: 1px;
    color: rgba(111, 255, 166, 0.52);
}
.battle-points-panel {
    width: 290px;
    height: 86px;
    margin-top: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}
.battle-points-panel .micro-label {
    margin-right: 20px;
    font-size: 20px;
    letter-spacing: 2px;
    color: rgba(111, 255, 166, 0.86);
    -unity-font-style: bold;
}
.battle-points-panel .points-value { font-size: 46px; }
.battle-points-panel .sunk-enemy-ships {
    left: 0;
    top: 64px;
    width: 290px;
    min-height: 0;
    padding: 0;
    background-color: transparent;
}
.ability-buttons {
    flex-grow: 1;
    height: 86px;
    flex-direction: row;
}
.ability-button {
    flex-grow: 1;
    margin-left: 10px;
    padding-left: 10px;
    padding-right: 14px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    background-color: rgba(5, 26, 15, 0.96);
    color: rgb(104, 255, 160);
    border-left-color: rgba(68, 255, 139, 0.52);
    border-right-color: rgba(68, 255, 139, 0.52);
    border-top-color: rgba(68, 255, 139, 0.52);
    border-bottom-color: rgba(68, 255, 139, 0.52);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-radius: 0;
    font-size: 20px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    white-space: nowrap;
}
.ability-cost {
    width: 64px;
    min-width: 64px;
    margin-right: 14px;
    font-size: 38px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    color: rgb(115, 255, 170);
}
.ability-name {
    flex-grow: 1;
    font-size: 18px;
    letter-spacing: 1px;
    -unity-text-align: middle-left;
    -unity-font-style: bold;
    color: rgb(104, 255, 160);
    white-space: nowrap;
}
.ability-button:hover {
    background-color: rgba(20, 76, 42, 0.95);
}
.ability-button:disabled {
    opacity: 0.34;
}
.ability-active {
    background-color: rgba(41, 255, 117, 0.22);
    border-left-color: rgb(70, 255, 140);
    border-right-color: rgb(70, 255, 140);
    border-top-color: rgb(70, 255, 140);
    border-bottom-color: rgb(70, 255, 140);
}
.cell-ability-preview {
    background-color: rgba(70, 255, 140, 0.12);
    border-left-color: rgba(89, 255, 153, 0.75);
    border-right-color: rgba(89, 255, 153, 0.75);
    border-top-color: rgba(89, 255, 153, 0.75);
    border-bottom-color: rgba(89, 255, 153, 0.75);
}
.cell-scanned {
    color: rgba(72, 255, 151, 0.5);
    font-size: 19px;
}
.cell-mine {
    color: rgb(255, 194, 62);
    font-size: 20px;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(255, 151, 30, 0.3);
}
.cell-revealed {
    border-left-color: rgba(255, 193, 63, 0.72);
    border-right-color: rgba(255, 193, 63, 0.72);
    border-top-color: rgba(255, 193, 63, 0.72);
    border-bottom-color: rgba(255, 193, 63, 0.72);
}
.cell-rangefinder-area {
    background-color: rgba(36, 128, 255, 0.16);
}
.cell-rangefinder-edge {
    border-left-color: rgba(71, 179, 255, 0.95);
    border-right-color: rgba(71, 179, 255, 0.95);
    border-top-color: rgba(71, 179, 255, 0.95);
    border-bottom-color: rgba(71, 179, 255, 0.95);
}

/* Arjan Dhillon // Vector */
.ability-cinematic-vector-rangefinder .ability-ocean-grade,
.ability-cinematic-vector-barrage .ability-ocean-grade {
    background-color: rgba(0, 28, 46, 0.28);
}
.ability-cinematic-vector-rangefinder .ability-cinematic-panel,
.ability-cinematic-vector-barrage .ability-cinematic-panel {
    position: relative;
    width: 100%;
    height: 100%;
    padding: 0;
    overflow: hidden;
    background-color: transparent;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}
.vector-target-ship {
    position: absolute;
    left: 16%;
    right: 16%;
    top: 38%;
    height: 25%;
    background-image: url("project://database/Assets/Art/NavalCommand/shot-animation/shot-enemy-close-destroyer.png");
    -unity-background-scale-mode: scale-to-fit;
}
.vector-missile {
    position: absolute;
    left: 50%;
    top: -140px;
    width: 34px;
    height: 118px;
    margin-left: -17px;
    opacity: 0;
    rotate: 180deg;
    transition-property: opacity, translate;
    transition-duration: 0.8s;
    transition-timing-function: ease-in;
}
.vector-missile-sprite,
.vector-barrage-missile {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("project://database/Assets/Art/NavalCommand/shot-animation/shot-missile.png");
    -unity-background-scale-mode: scale-to-fit;
}
.vector-missile-trail {
    position: absolute;
    left: 13px;
    top: 100px;
    width: 8px;
    height: 180px;
    background-color: rgba(67, 177, 255, 0.54);
}
.vector-missile-flame {
    position: absolute;
    left: 8px;
    top: 98px;
    width: 18px;
    height: 45px;
    background-color: rgb(255, 174, 52);
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
}
.vector-shot-incoming .vector-missile { opacity: 1; translate: 0 930px; }
.vector-impact-hit .vector-missile,
.vector-impact-miss .vector-missile { opacity: 0; transition-duration: 0.04s; }
.vector-impact {
    position: absolute;
    left: 50%;
    top: 67%;
    width: 1px;
    height: 1px;
}
.vector-hit-explosion,
.vector-miss-splash {
    position: absolute;
    opacity: 0;
    scale: 0.12 0.12;
    -unity-background-scale-mode: scale-to-fit;
    transition-property: opacity, scale, translate;
    transition-duration: 0.24s;
}
.vector-hit-explosion {
    left: -165px;
    top: -170px;
    width: 330px;
    height: 250px;
    background-image: url("project://database/Assets/Art/NavalCommand/shot-animation/shot-hit-explosion.png");
}
.vector-miss-splash {
    left: -115px;
    top: -225px;
    width: 230px;
    height: 250px;
    background-image: url("project://database/Assets/Art/NavalCommand/shot-animation/shot-water-splash.png");
}
.vector-impact-hit .vector-hit-explosion,
.vector-impact-miss .vector-miss-splash { opacity: 1; scale: 1 1; translate: 0 -12px; }
.vector-scan-ring {
    position: absolute;
    left: -38px;
    top: -38px;
    width: 76px;
    height: 76px;
    opacity: 0;
    scale: 0.15 0.15;
    border-left-width: 7px;
    border-right-width: 7px;
    border-top-width: 7px;
    border-bottom-width: 7px;
    border-left-color: rgb(57, 168, 255);
    border-right-color: rgb(57, 168, 255);
    border-top-color: rgb(57, 168, 255);
    border-bottom-color: rgb(57, 168, 255);
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
    transition-property: opacity, scale;
    transition-duration: 0.72s;
}
.vector-impact-miss .vector-scan-ring { opacity: 0.82; scale: 7 7; }
.vector-impact-miss .vector-scan-ring-two { transition-duration: 1.05s; scale: 10 10; opacity: 0.36; }
.vector-distance-result {
    position: absolute;
    left: 5%;
    right: 5%;
    top: 18%;
    height: 120px;
    opacity: 0;
    scale: 0.72 0.72;
    -unity-text-align: middle-center;
    font-size: 58px;
    letter-spacing: 6px;
    -unity-font-style: bold;
    color: rgb(112, 205, 255);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgba(0, 23, 42, 0.9);
    transition-property: opacity, scale;
    transition-duration: 0.24s;
}
.vector-scan-complete .vector-distance-result { opacity: 1; scale: 1 1; }
.ability-cinematic-vector-rangefinder .ability-cinematic-result,
.ability-cinematic-vector-barrage .ability-cinematic-result {
    position: absolute;
    left: 5%;
    right: 5%;
    bottom: 5%;
}
.vector-barrage-shot {
    position: absolute;
    top: 63%;
    width: 1px;
    height: 1px;
}
.vector-barrage-shot-0 { left: 25%; }
.vector-barrage-shot-1 { left: 36%; top: 69%; }
.vector-barrage-shot-2 { left: 47%; top: 61%; }
.vector-barrage-shot-3 { left: 58%; top: 67%; }
.vector-barrage-shot-4 { left: 69%; top: 60%; }
.vector-barrage-shot-5 { left: 78%; top: 68%; }
.vector-barrage-shot.vector-barrage-will-hit { top: 55%; }
.vector-barrage-shot.vector-barrage-will-miss { top: 70%; }
.standard-line-horizontal .vector-barrage-shot-0 { left: 34%; top: 64%; }
.standard-line-horizontal .vector-barrage-shot-1 { left: 50%; top: 64%; }
.standard-line-horizontal .vector-barrage-shot-2 { left: 66%; top: 64%; }
.standard-line-vertical .vector-barrage-shot-0 { left: 50%; top: 52%; }
.standard-line-vertical .vector-barrage-shot-1 { left: 50%; top: 63%; }
.standard-line-vertical .vector-barrage-shot-2 { left: 50%; top: 74%; }
.vector-barrage-missile {
    left: -16px;
    top: -720px;
    width: 32px;
    height: 112px;
    opacity: 0;
    rotate: 180deg;
    transition-property: opacity, translate;
    transition-duration: 0.36s;
    transition-timing-function: ease-in;
}
.vector-barrage-explosion,
.vector-barrage-splash {
    position: absolute;
    opacity: 0;
    -unity-background-scale-mode: scale-to-fit;
    transition-property: opacity, scale;
    transition-duration: 0.2s;
}
.vector-barrage-explosion {
    left: -110px;
    top: -115px;
    width: 220px;
    height: 165px;
    scale: 0.15 0.15;
    background-image: url("project://database/Assets/Art/NavalCommand/shot-animation/shot-hit-explosion.png");
}
.vector-barrage-splash {
    left: -72px;
    top: -145px;
    width: 144px;
    height: 158px;
    scale: 0.18 0.18;
    background-image: url("project://database/Assets/Art/NavalCommand/shot-animation/shot-water-splash.png");
}
.vector-barrage-fire-0 .vector-barrage-shot-0 .vector-barrage-missile,
.vector-barrage-fire-1 .vector-barrage-shot-1 .vector-barrage-missile,
.vector-barrage-fire-2 .vector-barrage-shot-2 .vector-barrage-missile,
.vector-barrage-fire-3 .vector-barrage-shot-3 .vector-barrage-missile,
.vector-barrage-fire-4 .vector-barrage-shot-4 .vector-barrage-missile,
.vector-barrage-fire-5 .vector-barrage-shot-5 .vector-barrage-missile { opacity: 1; translate: 0 690px; }
.vector-barrage-impact-0 .vector-barrage-shot-0 .vector-barrage-missile,
.vector-barrage-impact-1 .vector-barrage-shot-1 .vector-barrage-missile,
.vector-barrage-impact-2 .vector-barrage-shot-2 .vector-barrage-missile,
.vector-barrage-impact-3 .vector-barrage-shot-3 .vector-barrage-missile,
.vector-barrage-impact-4 .vector-barrage-shot-4 .vector-barrage-missile,
.vector-barrage-impact-5 .vector-barrage-shot-5 .vector-barrage-missile { opacity: 0; }
.vector-barrage-impact-0 .vector-barrage-shot-0.vector-barrage-will-hit .vector-barrage-explosion,
.vector-barrage-impact-1 .vector-barrage-shot-1.vector-barrage-will-hit .vector-barrage-explosion,
.vector-barrage-impact-2 .vector-barrage-shot-2.vector-barrage-will-hit .vector-barrage-explosion,
.vector-barrage-impact-3 .vector-barrage-shot-3.vector-barrage-will-hit .vector-barrage-explosion,
.vector-barrage-impact-4 .vector-barrage-shot-4.vector-barrage-will-hit .vector-barrage-explosion,
.vector-barrage-impact-5 .vector-barrage-shot-5.vector-barrage-will-hit .vector-barrage-explosion,
.vector-barrage-impact-0 .vector-barrage-shot-0.vector-barrage-will-miss .vector-barrage-splash,
.vector-barrage-impact-1 .vector-barrage-shot-1.vector-barrage-will-miss .vector-barrage-splash,
.vector-barrage-impact-2 .vector-barrage-shot-2.vector-barrage-will-miss .vector-barrage-splash,
.vector-barrage-impact-3 .vector-barrage-shot-3.vector-barrage-will-miss .vector-barrage-splash,
.vector-barrage-impact-4 .vector-barrage-shot-4.vector-barrage-will-miss .vector-barrage-splash,
.vector-barrage-impact-5 .vector-barrage-shot-5.vector-barrage-will-miss .vector-barrage-splash { opacity: 1; scale: 1 1; }
.ship-2b { background-image: url("project://database/Assets/Art/NavalCommand/individual-ships/grid-ready-128/02-stealth-corvette-2x1.png"); }
.ship-4b { background-image: url("project://database/Assets/Art/NavalCommand/individual-ships/grid-ready-128/07-modern-battleship-4x1.png"); }

/* Lightweight ability FX registry */
.ability-fx {
    position: absolute;
    left: 8%;
    right: 8%;
    top: 24%;
    height: 150px;
    opacity: 0;
    translate: -120px 0;
    background-color: rgba(3, 24, 14, 0.96);
    border-left-width: 4px;
    border-left-color: rgb(68, 255, 139);
    align-items: center;
    justify-content: center;
    transition-property: opacity, translate;
    transition-duration: 0.18s;
}
.ability-fx-active {
    opacity: 1;
    translate: 0 0;
}
.ability-fx-label {
    font-size: 23px;
    letter-spacing: 4px;
    -unity-font-style: bold;
}
.fx-barrage { border-left-color: rgb(255, 94, 64); color: rgb(255, 151, 92); }
.fx-line { border-left-color: rgb(88, 205, 255); color: rgb(111, 224, 255); }
.fx-scan { border-left-color: rgb(53, 255, 151); color: rgb(90, 255, 174); }
.fx-repair { border-left-color: rgb(255, 210, 82); color: rgb(255, 225, 126); }
.fx-chemical { border-left-color: rgb(163, 255, 63); color: rgb(190, 255, 100); }
.fx-mine { border-left-color: rgb(255, 151, 45); color: rgb(255, 188, 88); }

/* Online platform */
.topbar-button {
    min-width: 116px;
    height: 46px;
    margin-left: auto;
    margin-right: 18px;
    color: rgb(101, 255, 168);
    background-color: rgba(3, 27, 18, 0.9);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(84, 255, 166, 0.46);
    border-right-color: rgba(84, 255, 166, 0.46);
    border-top-color: rgba(84, 255, 166, 0.46);
    border-bottom-color: rgba(84, 255, 166, 0.46);
